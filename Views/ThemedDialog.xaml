<Window x:Class="Visor.ThemedDialog"
        UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        MaxWidth="460"
        Opacity="0"
        Loaded="Window_Loaded">
    <!-- Shadow on its own layer: a DropShadowEffect on the card itself rasterizes every child (title, message,
         buttons) into the effect bitmap, so the text renders soft at 125/150 %. -->
    <Grid x:Name="Card" Margin="12">
        <Border CornerRadius="14" Background="{DynamicResource PanelBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="14"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="14,14,0,0" Padding="14,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button x:Name="BtnClose" DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}"
                            Width="28" Height="28" Click="Close_Click" Margin="8,0,0,0">
                        <Path Width="8" Height="8" Stretch="Uniform"
                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2"
                              Data="M1,1 L9,9 M9,1 L1,9"/>
                    </Button>
                    <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,8,0"
                            Background="{DynamicResource BrandGradientBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="Visor"
                               Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Long messages (e.g. the list of found games) scroll inside the card instead of growing past the screen. -->
            <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,12">
                <TextBlock x:Name="MessageText" Text=""
                           Margin="18,0,18,0" Foreground="{DynamicResource TextBrush}" FontSize="13"
                           TextWrapping="Wrap" LineHeight="19"/>
            </ScrollViewer>

            <TextBox Grid.Row="2" x:Name="InputBox" Margin="18,0,18,16" Visibility="Collapsed"/>

            <Border Grid.Row="3" Background="{DynamicResource TitleBarBrush}" CornerRadius="0,0,14,14" Padding="14,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource GhostButton}"
                            MinWidth="80" Margin="0,0,8,0" Visibility="Collapsed" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="BtnOk" Content="OK" Style="{StaticResource AccentButton}"
                            MinWidth="80" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
