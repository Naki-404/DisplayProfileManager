<Window x:Class="Visor.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Running processes" Height="500" Width="440"
        MinHeight="360" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}" DockPanel.Dock="Right"
                        Width="36" Height="28" Click="Cancel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="9" Height="9" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2"
                          Data="M1,1 L9,9 M9,1 L1,9"/>
                </Button>
                <TextBlock x:Name="TxtTitle" Text="Running processes" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBox Grid.Row="1" x:Name="TxtFilter" Margin="0,14,0,8" TextChanged="TxtFilter_TextChanged"
                     PreviewKeyDown="TxtFilter_PreviewKeyDown"/>

            <Grid Grid.Row="2">
                <ListBox x:Name="ProcList" MouseDoubleClick="ProcList_MouseDoubleClick"
                         SelectionChanged="ProcList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="BtnSelect" Content="Select" Style="{StaticResource AccentButton}" IsDefault="True"
                        IsEnabled="False" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
