<Window x:Class="Visor.OsdWindow"
        UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visor OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000">
    <!-- In-game banner: click-through, never activates, auto-hides. The shadow is a sibling layer behind the card
         (an Effect on the card would rasterize the title text); Card (Grid) keeps the fade + slide. -->
    <Grid x:Name="Card" Margin="14" Opacity="0" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-8"/>
        </Grid.RenderTransform>
        <Border CornerRadius="14" Background="{DynamicResource PanelBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="14" Padding="0"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid MinWidth="220" MaxWidth="460">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="4" CornerRadius="14,0,0,14" Background="{DynamicResource BrandGradientBrush}"/>
                <!-- DockPanel (not a horizontal StackPanel): the text column gets a finite width, so long titles
                     trim with an ellipsis at MaxWidth instead of being cut off mid-glyph. -->
                <DockPanel Grid.Column="1" Margin="14,10,20,10" VerticalAlignment="Center">
                    <Image x:Name="Logo" DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubText" FontSize="11" FontFamily="Segoe UI" Margin="0,1,0,0"
                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
