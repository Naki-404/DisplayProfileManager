<local:ShellPageBase x:Class="Visor.MonitorPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Visor"
        xmlns:controls="clr-namespace:Visor.Controls">
    <!-- Monitor: FPS / frametime capture through Visor's built-in ETW engine (elevated helper, user-started only). -->
    <local:ShellPageBase.Resources>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource CardSurface}">
            <Setter Property="Padding" Value="12,10"/>
            <!-- 12-DIP gutters like every other card grid. -->
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="156"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </local:ShellPageBase.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel Margin="4,4,12,8">

            <!-- Header: state pill · target · Start / Stop -->
            <Border Style="{StaticResource CardSurface}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnMonStart" Style="{StaticResource CompactAccentButton}" Click="Start_Click"
                                    ToolTipService.ShowOnDisabled="True"/>
                            <Button x:Name="BtnMonStop" Style="{StaticResource CompactGhostButton}" Margin="8,0,0,0"
                                    Click="Stop_Click" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StatePill" Padding="10,3" CornerRadius="10" VerticalAlignment="Center"
                                    Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <controls:StatusDot x:Name="DotState" Width="7" Height="7" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtState" FontSize="11" Foreground="{DynamicResource TextBrush}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtLiveTarget" Style="{StaticResource Hint}" FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="LblTarget" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button x:Name="BtnPickRunning" DockPanel.Dock="Right" Style="{StaticResource CompactGhostButton}"
                                Margin="8,0,0,0" Click="PickRunning_Click"/>
                        <ComboBox x:Name="CmbTarget" IsEditable="True" MinWidth="260" MaxWidth="520" HorizontalAlignment="Left"
                                  AutomationProperties.LabeledBy="{Binding ElementName=LblTarget}"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtTargetHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Error / notice card (one MonitorErrorCode at a time) -->
            <Border x:Name="ErrorCard" Style="{StaticResource CardSurface}" Padding="14" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource DangerBrush}" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <controls:StatusDot x:Name="DotError" DockPanel.Dock="Left" Margin="0,5,10,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtErrorTitle" Style="{StaticResource CardValue}" FontSize="14"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtErrorBody" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtErrorDetail" Style="{StaticResource Hint}" FontFamily="Consolas" Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="BtnRetry" Style="{StaticResource CompactGhostButton}" Margin="0,0,8,6"
                                Click="Retry_Click" Visibility="Collapsed"/>
                        <Button x:Name="BtnDismiss" Style="{StaticResource CompactGhostButton}" Margin="0,0,8,6"
                                Click="Dismiss_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Live numbers (window = last N seconds of the capture) -->
            <WrapPanel x:Name="StatsPanel" Margin="0,0,-12,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="TxtFpsAvg" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock x:Name="LblFpsAvg" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="TxtLow1" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock x:Name="LblLow1" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="TxtLow01" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock x:Name="LblLow01" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="TxtP99" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock x:Name="LblP99" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="TxtStutters" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock x:Name="LblStutters" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardBound" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock x:Name="TxtBound" Style="{StaticResource StatValue}" FontSize="18" Text="—" Margin="0,4,0,2"/>
                        <TextBlock x:Name="LblBound" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
                <!-- Click-to-photon is not measured by the built-in capture: shown only if a summary ever carries it. -->
                <Border x:Name="CardC2p" Style="{StaticResource StatCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtC2p" Style="{StaticResource StatValue}" Text="—"/>
                        <TextBlock x:Name="LblC2p" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <TextBlock x:Name="TxtFramesLine" Style="{StaticResource Hint}" Margin="0,0,0,12"/>

            <!-- Frametime chart -->
            <Border Style="{StaticResource CardSurface}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="TxtChartLegend" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblChart" Style="{StaticResource SubHeader}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <controls:FrameChart x:Name="Chart" Height="200"/>
                </StackPanel>
            </Border>

            <!-- Last session (shown after a capture ended) -->
            <Border x:Name="SummaryCard" Style="{StaticResource CardSurface}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LblSummary" Style="{StaticResource SubHeader}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSummary" Style="{StaticResource CardValue}" FontSize="14"/>
                    <TextBlock x:Name="TxtSummaryDetail" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtExperiment" Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtHowItWorks" Style="{StaticResource Hint}"/>
        </StackPanel>
    </ScrollViewer>
</local:ShellPageBase>
