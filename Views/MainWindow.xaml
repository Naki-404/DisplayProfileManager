<Window x:Class="Visor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Visor"
        Title="Visor"
        Height="720" Width="1080"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Game tile used by the Play / Library lists -->
        <DataTemplate x:Key="GameTileTemplate">
            <Border CornerRadius="8" Padding="8,7" Background="{Binding TileBrush}" MinHeight="48"
                    ToolTip="{Binding ProcessName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="#33000000" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource InvNullToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                   Foreground="{Binding TileBrush, Converter={StaticResource TileFgMuted}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Compact tile (Presets tab game picker) -->
        <DataTemplate x:Key="GameTileCompactTemplate">
            <Border CornerRadius="8" Padding="8,6" Background="{Binding TileBrush}" MinHeight="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="6" Background="#33000000">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="11"
                                       Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource InvNullToVis}}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SliderName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}" Opacity="0">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image x:Name="TitleLogo" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TitleAppName" Text="Visor" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="" Margin="12,0,0,0" FontSize="11" Opacity="0.85"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Border x:Name="ActivePill" Margin="12,0,0,0" Padding="10,3" CornerRadius="10"
                        Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ActiveDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="ActiveHeaderText" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="BtnSettingsCaption" Style="{StaticResource CaptionButton}" Click="Settings_Click"
                        MinWidth="72" Width="Auto" Padding="10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource MutedBrush}" Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10Z"/>
                        <TextBlock x:Name="TxtSettingsCaption" Text="Settings" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
                          Data="M0,4 L8,4"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
                          Data="M0.5,0.5 H7.5 V7.5 H0.5 Z" Fill="Transparent"/>
                </Button>
                <Button x:Name="BtnCloseCaption" Style="{StaticResource CaptionCloseButton}" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
                          Data="M1,1 L7,7 M7,1 L1,7"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentRoot" Grid.Row="1" Margin="16,10,16,10" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0">
            <!-- ============================== PLAY ============================== -->
            <TabItem x:Name="TabPlay" Header="Play">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LblPlayTitle" Grid.Row="0" Text="Now playing" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtPlayName" Text="" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPlayProcess" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                                <Border x:Name="PlayStatusPill" Background="{DynamicResource PillBgBrush}" CornerRadius="10" Padding="10,3"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PlayStatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="TxtPlayStatus" Text="" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <ListBox x:Name="PlayGameList" SelectionChanged="PlayGameList_SelectionChanged"
                                         ItemTemplate="{StaticResource GameTileTemplate}"
                                         ItemContainerStyle="{StaticResource TileListItem}"/>
                                <StackPanel x:Name="PlayEmpty" VerticalAlignment="Center" Margin="8" Visibility="Collapsed">
                                    <TextBlock x:Name="LblPlayEmpty" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnPlayEmptyScan" Style="{StaticResource CompactAccentButton}"
                                            HorizontalAlignment="Center" Click="ScanGames_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3">
                                <UniformGrid Columns="2">
                                    <Button x:Name="BtnPlayLaunch" Content="Launch game" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,4,0" Click="PlayLaunch_Click"/>
                                    <Button x:Name="BtnPlayOverlay" Content="Live overlay" Style="{StaticResource CompactGhostButton}"
                                            Margin="4,0,0,0" Click="Overlay_Click"/>
                                </UniformGrid>
                                <Button x:Name="BtnPlayGameSettings" Style="{StaticResource LinkButton}" Margin="0,10,0,0"
                                        Content="Game settings" Click="PlayGameSettings_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" PanningMode="VerticalOnly">
                            <StackPanel x:Name="PlayEditor" Margin="20,16,20,16">
                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="ChkPlayPreview" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                              Content="Preview on desktop" Checked="PlayPreview_Changed" Unchecked="PlayPreview_Changed"/>
                                    <TextBlock x:Name="LblPlayColor" Text="Live color" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border x:Name="PlayHintBox" CornerRadius="8" Padding="10,7" Margin="0,4,0,12"
                                        Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <Ellipse x:Name="PlayHintDot" Width="7" Height="7" Margin="0,5,8,0" VerticalAlignment="Top"
                                                 Fill="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="LblPlayColorHint" Style="{StaticResource Hint}" FontSize="12"/>
                                    </DockPanel>
                                </Border>

                                <StackPanel x:Name="PlaySliders">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblPlayB" Text="Brightness" Style="{StaticResource SliderName}"/>
                                        <Slider Grid.Column="1" x:Name="SldPlayB" Minimum="0" Maximum="1" TickFrequency="0.01"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsSnapToTickEnabled="True" ValueChanged="PlaySlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="ValPlayB" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblPlayC" Text="Contrast" Style="{StaticResource SliderName}"/>
                                        <Slider Grid.Column="1" x:Name="SldPlayC" Minimum="0" Maximum="2" TickFrequency="0.01"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsSnapToTickEnabled="True" ValueChanged="PlaySlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="ValPlayC" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblPlayG" Text="Gamma" Style="{StaticResource SliderName}"/>
                                        <Slider Grid.Column="1" x:Name="SldPlayG" Minimum="0.5" Maximum="6" TickFrequency="0.01"
                                                SmallChange="0.01" LargeChange="0.1"
                                                IsSnapToTickEnabled="True" ValueChanged="PlaySlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="ValPlayG" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblPlayV" Text="Vibrance" Style="{StaticResource SliderName}"/>
                                        <Slider Grid.Column="1" x:Name="SldPlayV" Minimum="0" Maximum="100" TickFrequency="1"
                                                SmallChange="1" LargeChange="5"
                                                IsSnapToTickEnabled="True" ValueChanged="PlaySlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="ValPlayV" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblPlayH" Text="Hue" Style="{StaticResource SliderName}"/>
                                        <Slider Grid.Column="1" x:Name="SldPlayH" Minimum="0" Maximum="359" TickFrequency="1"
                                                SmallChange="1" LargeChange="10"
                                                IsSnapToTickEnabled="True" ValueChanged="PlaySlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="ValPlayH" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblPlayS" Text="Shadows" Style="{StaticResource SliderName}"/>
                                        <Slider Grid.Column="1" x:Name="SldPlayS" Minimum="0" Maximum="100" TickFrequency="1"
                                                SmallChange="1" LargeChange="5"
                                                IsSnapToTickEnabled="True" ValueChanged="PlaySlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="ValPlayS" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                </StackPanel>

                                <DockPanel Margin="0,4,0,6">
                                    <Button x:Name="BtnPlayEditPreset" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                            Click="PlayEditPreset_Click"/>
                                    <TextBlock x:Name="LblPlayPresets" Text="Presets" Style="{StaticResource SubHeader}" Margin="0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel x:Name="PlayPresetChips" Margin="0,0,0,4"/>

                                <Expander x:Name="ExpPlayHotkeys" Header="Hotkeys" IsExpanded="False" Margin="0,10,0,0">
                                    <TextBlock x:Name="TxtPlayHotkeys" Margin="2,0,0,0" Style="{StaticResource Hint}" FontSize="12"
                                               LineHeight="20"/>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================== LIBRARY ============================== -->
            <TabItem x:Name="TabProfiles" Header="Library">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="TxtSearch" Margin="0,0,0,8" Padding="9,6" FontSize="12"
                                         VerticalContentAlignment="Center" TextChanged="Search_Changed"/>
                                <UniformGrid Columns="2">
                                    <Button x:Name="BtnScan" Content="Scan" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,4,0" Click="ScanGames_Click"/>
                                    <Button x:Name="BtnAddManual" Content="Add" Style="{StaticResource CompactGhostButton}"
                                            Margin="4,0,0,0" Click="AddProfile_Click"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button x:Name="BtnDup" Content="Duplicate" Style="{StaticResource CompactGhostButton}"
                                            Margin="0,0,4,0" Click="DupProfile_Click"/>
                                    <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource DangerGhostButton}"
                                            Margin="4,0,0,0" Click="DeleteProfile_Click"/>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button x:Name="BtnExportProfile" Content="Export" Style="{StaticResource CompactGhostButton}"
                                            Margin="0,0,4,0" Click="ExportProfile_Click"/>
                                    <Button x:Name="BtnImportProfile" Content="Import" Style="{StaticResource CompactGhostButton}"
                                            Margin="4,0,0,0" Click="ImportProfile_Click"/>
                                </UniformGrid>
                                <Button x:Name="BtnRestore" Content="Restore default games" Style="{StaticResource LinkButton}"
                                        Margin="0,8,0,0" Click="RestoreCoreGames_Click"/>
                            </StackPanel>
                            <Grid>
                                <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged"
                                         ItemTemplate="{StaticResource GameTileTemplate}"
                                         ItemContainerStyle="{StaticResource TileListItem}"/>
                                <StackPanel x:Name="LibraryEmpty" VerticalAlignment="Center" Margin="8" Visibility="Collapsed">
                                    <TextBlock x:Name="LblLibraryEmpty" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnLibraryEmptyAction" Style="{StaticResource CompactAccentButton}"
                                            HorizontalAlignment="Center" Click="LibraryEmptyAction_Click"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" PanningMode="VerticalOnly">
                            <StackPanel x:Name="EditorPanel" Margin="20,16,20,16">
                                <DockPanel Margin="0,0,0,10">
                                    <CheckBox x:Name="ChkEnabled" DockPanel.Dock="Right" Content="Enabled" VerticalAlignment="Center"
                                              Checked="EditorChanged" Unchecked="EditorChanged"/>
                                    <TextBlock x:Name="LblProfileTitle" Text="Game profile" Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock x:Name="LblName" Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtName" TextChanged="EditorChanged"/>

                                <TextBlock x:Name="LblProcess" Text="Game process (.exe)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtProcess" Grid.Column="0" TextChanged="EditorChanged"/>
                                    <Button x:Name="BtnBrowseExe" Grid.Column="1" Content="Browse" Style="{StaticResource CompactGhostButton}"
                                            Margin="6,0,0,0" Click="BrowseExe_Click"/>
                                    <Button x:Name="BtnPickRunning" Grid.Column="2" Content="Running" Style="{StaticResource CompactGhostButton}"
                                            Margin="6,0,0,0" Click="PickRunning_Click"/>
                                </Grid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnLaunchGame" Content="Launch game" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,8,0" MinWidth="120" HorizontalAlignment="Left" Click="LaunchGame_Click"/>
                                    <Button x:Name="BtnApplyProfileNow" Content="Apply now" Style="{StaticResource CompactGhostButton}"
                                            Margin="0,0,8,0" HorizontalAlignment="Left" Click="ApplyProfileNow_Click"/>
                                    <Button x:Name="BtnOverlay" Content="Live overlay" Style="{StaticResource CompactGhostButton}"
                                            HorizontalAlignment="Left" Click="Overlay_Click"/>
                                </WrapPanel>

                                <Separator/>
                                <TextBlock x:Name="LblDisplaySection" Text="Display" Style="{StaticResource SubHeader}"/>
                                <CheckBox x:Name="ChkApplyRes" Content="Change resolution"
                                          Checked="EditorChanged" Unchecked="EditorChanged"/>
                                <Grid x:Name="ResolutionPanel" Margin="24,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="LblResolution" Text="Resolution" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbResolution" Grid.Row="1" IsEditable="True"
                                              SelectionChanged="Resolution_Changed" LostFocus="Resolution_LostFocus"/>
                                    <TextBlock x:Name="LblRefreshRate" Grid.Column="2" Text="Refresh rate" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbRefreshRate" Grid.Column="2" Grid.Row="1" SelectionChanged="EditorChanged"/>
                                    <TextBlock x:Name="LblDisplay" Grid.Row="2" Grid.ColumnSpan="3" Text="Monitor" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbDisplay" Grid.Row="3" Grid.ColumnSpan="3" SelectionChanged="Display_Changed"/>
                                </Grid>
                                <CheckBox x:Name="ChkApplyPower" Content="Change power plan" Margin="0,12,0,4"
                                          Checked="EditorChanged" Unchecked="EditorChanged"/>
                                <ComboBox x:Name="CmbPower" Margin="24,4,0,0" SelectionChanged="EditorChanged">
                                    <ComboBoxItem x:Name="ItmPowerHigh" Content="High performance" Tag="highPerformance"/>
                                    <ComboBoxItem x:Name="ItmPowerBalanced" Content="Balanced" Tag="balanced"/>
                                </ComboBox>

                                <Separator/>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnOpenPresets" DockPanel.Dock="Right" Content="Edit presets"
                                            Style="{StaticResource LinkButton}" Click="OpenPresets_Click"/>
                                    <TextBlock x:Name="LblPresetsSection" Text="Presets" Style="{StaticResource SubHeader}" Margin="0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="LblColorSummary" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,6" LineHeight="18"/>
                                <TextBlock x:Name="LblStartupPreset" Text="Startup preset" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                                <ComboBox x:Name="CmbStartupPreset" SelectionChanged="EditorChanged"/>

                                <Expander x:Name="ExpAdvanced" Header="Advanced" IsExpanded="False" Margin="0,16,0,0">
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock x:Name="LblAliases" Text="Process aliases (comma-separated)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtAliases" TextChanged="EditorChanged"/>
                                        <TextBlock x:Name="LblApplyDelay" Text="Apply delay: 0 s" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="SldApplyDelay" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="10" ValueChanged="EditorSlider_ValueChanged"/>
                                        <CheckBox x:Name="ChkApplyOnFocus" Content="Wait for game window focus" Margin="0,4,0,0"
                                                  Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <local:InfoHint x:Name="InfoSoftAltTab" DockPanel.Dock="Right"/>
                                            <CheckBox x:Name="ChkSoftAltTab" Content="Soft restore on Alt-Tab" VerticalAlignment="Center"
                                                      Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,10,0,4">
                                            <local:InfoHint x:Name="InfoFpsLimit" DockPanel.Dock="Right"/>
                                            <TextBlock x:Name="LblFpsLimit" Text="FPS limit (NVIDIA only)" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ComboBox x:Name="CmbFpsLimit" IsEditable="True" SelectionChanged="EditorChanged" LostFocus="FpsLimit_LostFocus">
                                            <ComboBoxItem x:Name="ItmFpsOff" Content="Off" Tag="0"/>
                                            <ComboBoxItem Content="30" Tag="30"/>
                                            <ComboBoxItem Content="60" Tag="60"/>
                                            <ComboBoxItem Content="120" Tag="120"/>
                                            <ComboBoxItem Content="144" Tag="144"/>
                                            <ComboBoxItem Content="165" Tag="165"/>
                                            <ComboBoxItem Content="240" Tag="240"/>
                                        </ComboBox>
                                        <TextBlock x:Name="LblFpsLimitHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                        <DockPanel Margin="0,12,0,4">
                                            <local:InfoHint x:Name="InfoRestoreMode" DockPanel.Dock="Right"/>
                                            <TextBlock x:Name="LblRestoreMode" Text="On game exit" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ComboBox x:Name="CmbRestoreMode" SelectionChanged="EditorChanged">
                                            <ComboBoxItem x:Name="ItmRestoreSnapshot" Tag="PreviousSnapshot"/>
                                            <ComboBoxItem x:Name="ItmRestoreDefaults" Tag="GlobalDefaults"/>
                                            <ComboBoxItem x:Name="ItmRestoreNothing" Tag="DoNothing"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Expander>

                                <Expander x:Name="ExpSession" Header="Session extras" IsExpanded="False" Margin="0,8,0,0">
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock x:Name="LblSessionSub" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblSessionTemplates" Text="Templates" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <Button x:Name="BtnTplCompetitive" Content="Competitive" Style="{StaticResource CompactGhostButton}"
                                                    Margin="0,0,4,0" Click="SessionTemplateCompetitive_Click"/>
                                            <Button x:Name="BtnTplImmersive" Content="Immersive" Style="{StaticResource CompactGhostButton}"
                                                    Margin="2,0,2,0" Click="SessionTemplateImmersive_Click"/>
                                            <Button x:Name="BtnTplMinimal" Content="Minimal" Style="{StaticResource CompactGhostButton}"
                                                    Margin="4,0,0,0" Click="SessionTemplateMinimal_Click"/>
                                        </UniformGrid>
                                        <TextBlock x:Name="LblMonitorLayout" Text="Monitor layout" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                                        <ComboBox x:Name="CmbMonitorLayout" Margin="0,0,0,8" SelectionChanged="EditorChanged">
                                            <ComboBoxItem x:Name="ItmLayoutKeep" Tag="keepAll"/>
                                            <ComboBoxItem x:Name="ItmLayoutIsolate" Tag="isolatePrimary"/>
                                            <ComboBoxItem x:Name="ItmLayoutPrimary" Tag="primaryOnly"/>
                                        </ComboBox>
                                        <DockPanel>
                                            <local:InfoHint x:Name="InfoDeferred" DockPanel.Dock="Right"/>
                                            <TextBlock x:Name="LblDeferred" Text="Deferred re-apply: 0 s" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Slider x:Name="SldDeferred" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="5" ValueChanged="EditorSlider_ValueChanged"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <local:InfoHint x:Name="InfoQuiet" DockPanel.Dock="Right"/>
                                            <CheckBox x:Name="ChkQuietToast" Content="Quiet notifications" VerticalAlignment="Center"
                                                      Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        </DockPanel>
                                        <!-- Night Light is a no-op in the core now — kept hidden so old configs still load. -->
                                        <DockPanel Margin="0,2,0,0" Visibility="Collapsed">
                                            <local:InfoHint x:Name="InfoNight" DockPanel.Dock="Right"/>
                                            <CheckBox x:Name="ChkNoNightLight" Content="Disable Night Light" VerticalAlignment="Center"
                                                      Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,0">
                                            <local:InfoHint x:Name="InfoHdr" DockPanel.Dock="Right"/>
                                            <CheckBox x:Name="ChkNoAutoHdr" Content="Disable Auto HDR" VerticalAlignment="Center"
                                                      Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,0">
                                            <local:InfoHint x:Name="InfoMonBright" DockPanel.Dock="Right"/>
                                            <CheckBox x:Name="ChkMonBright" Content="Set monitor brightness (DDC/CI)" VerticalAlignment="Center"
                                                      Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        </DockPanel>
                                        <StackPanel x:Name="MonBrightPanel" Margin="24,0,0,0">
                                            <TextBlock x:Name="LblMonBright" Text="Panel brightness: 80%" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                            <Slider x:Name="SldMonBright" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="5" ValueChanged="EditorSlider_ValueChanged"/>
                                        </StackPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <local:InfoHint x:Name="InfoAudio" DockPanel.Dock="Right"/>
                                            <CheckBox x:Name="ChkSwitchAudio" Content="Switch default audio device" VerticalAlignment="Center"
                                                      Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        </DockPanel>
                                        <ComboBox x:Name="CmbAudio" Margin="24,4,0,0" SelectionChanged="EditorChanged"/>
                                        <DockPanel Margin="0,10,0,4">
                                            <local:InfoHint x:Name="InfoScaling" DockPanel.Dock="Right"/>
                                            <TextBlock x:Name="LblScaling" Text="Scaling mode" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ComboBox x:Name="CmbScaling" SelectionChanged="EditorChanged">
                                            <ComboBoxItem x:Name="ItmScaleDefault" Tag="default"/>
                                            <ComboBoxItem x:Name="ItmScaleStretch" Tag="stretch"/>
                                            <ComboBoxItem x:Name="ItmScaleCenter" Tag="center"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Expander>

                                <Separator/>
                                <DockPanel Margin="0,0,0,8">
                                    <local:InfoHint x:Name="InfoCompanions" DockPanel.Dock="Right"/>
                                    <TextBlock x:Name="LblCompanions" Text="Companion apps" Style="{StaticResource SubHeader}" Margin="0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid>
                                    <ListBox x:Name="CompanionList" MinHeight="44" MaxHeight="150"
                                             SelectionChanged="CompanionList_SelectionChanged"
                                             MouseDoubleClick="CompanionList_MouseDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Setter Property="Margin" Value="0,0,0,2"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource CompanionLabel}}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="LblCompanionsEmpty" Style="{StaticResource Hint}" Margin="4,8" IsHitTestVisible="False"/>
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <Button x:Name="BtnCompanionAdd" Content="Add" Style="{StaticResource CompactGhostButton}" Margin="0,0,6,0"
                                            MinWidth="72" Click="AddCompanion_Click"/>
                                    <Button x:Name="BtnCompanionEdit" Content="Edit" Style="{StaticResource CompactGhostButton}" Margin="0,0,6,0"
                                            MinWidth="72" IsEnabled="False" Click="EditCompanion_Click"/>
                                    <Button x:Name="BtnCompanionRemove" Content="Remove" Style="{StaticResource DangerGhostButton}"
                                            MinWidth="72" IsEnabled="False" Click="RemoveCompanion_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="LblEditorEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================== PRESETS ============================== -->
            <TabItem x:Name="TabPresets" Header="Presets">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock x:Name="LblPresetGamePick" DockPanel.Dock="Top" Text="Game" Style="{StaticResource SubHeader}"/>
                            <ListBox x:Name="PresetGameList" SelectionChanged="PresetGameList_SelectionChanged"
                                     ItemTemplate="{StaticResource GameTileCompactTemplate}"
                                     ItemContainerStyle="{StaticResource TileListItem}"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="LblPresetGame" Text="Presets"
                                       Style="{StaticResource SubHeader}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button x:Name="BtnPresetAdd" Content="Add" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,4,0" Click="AddPreset_Click"/>
                                    <Button x:Name="BtnPresetDelete" Content="Delete" Style="{StaticResource DangerGhostButton}"
                                            Margin="4,0,0,0" Click="DeletePreset_Click"/>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button x:Name="BtnPresetExport" Content="Export" Style="{StaticResource CompactGhostButton}"
                                            Margin="0,0,4,0" Click="ExportPresets_Click"/>
                                    <Button x:Name="BtnPresetImport" Content="Import" Style="{StaticResource CompactGhostButton}"
                                            Margin="4,0,0,0" Click="ImportPresets_Click"/>
                                </UniformGrid>
                                <Button x:Name="BtnPackGallery" Content="Pack gallery" Style="{StaticResource CompactGhostButton}"
                                        Click="PackGallery_Click"/>
                            </StackPanel>
                            <Grid>
                                <ListBox x:Name="PresetList" SelectionChanged="PresetList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="10,8"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Converter={StaticResource PresetSummary}}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                            Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" VerticalAlignment="Center"
                                                            Visibility="{Binding Hotkey, Converter={StaticResource NullToVis}}">
                                                        <TextBlock Text="{Binding Hotkey}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource MutedBrush}" MaxWidth="110"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Converter={StaticResource PresetSummary}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="PresetEmptyCta" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Margin="12" Visibility="Collapsed">
                                    <TextBlock x:Name="LblPresetEmpty" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnPresetEmptyGallery" Style="{StaticResource CompactAccentButton}"
                                            HorizontalAlignment="Center" Click="PackGallery_Click"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" PanningMode="VerticalOnly">
                            <StackPanel x:Name="PresetEditor" Margin="20,16,20,16">
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnApplyPreset" DockPanel.Dock="Right" Content="Apply now"
                                            Style="{StaticResource CompactAccentButton}" HorizontalAlignment="Right" Click="ApplyPresetNow_Click"/>
                                    <TextBlock x:Name="LblPresetEditorTitle" Text="Preset" Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock x:Name="LblPresetName" Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPresetName" TextChanged="PresetName_TextChanged" LostFocus="PresetName_LostFocus"/>

                                <TextBlock x:Name="LblPresetHotkey" Text="Hotkey" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPresetHotkey" IsReadOnly="True" Cursor="Hand"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                             GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                    <Button x:Name="BtnPresetHotkeyClear" Grid.Column="1" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                            Margin="6,0,0,0" Click="ClearHotkey_Click" Tag="{Binding ElementName=TxtPresetHotkey}"/>
                                </Grid>
                                <TextBlock x:Name="LblPresetHotkeyHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                                <CheckBox x:Name="ChkPresetRes" Content="Set resolution" Margin="0,12,0,4"
                                          Checked="PresetEditorChanged" Unchecked="PresetEditorChanged"/>
                                <ComboBox x:Name="CmbPresetRes" Margin="24,2,0,0" SelectionChanged="PresetEditorChanged"/>

                                <Separator/>
                                <TextBlock x:Name="LblPresetColor" Text="Color" Style="{StaticResource SubHeader}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="LblPresetColorHint" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,6">
                                    <local:InfoHint x:Name="InfoPresetBackend" DockPanel.Dock="Right"/>
                                    <TextBlock x:Name="LblPresetBackend" Text="Color method" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ToggleButton x:Name="TogPresetBackend" Style="{StaticResource BackendSlideToggle}"
                                              Content="NVIDIA" Checked="PresetBackendToggle_Changed" Unchecked="PresetBackendToggle_Changed"/>
                                <TextBlock x:Name="LblPresetBackendActive" Style="{StaticResource Hint}" Margin="2,6,0,6"/>
                                <DockPanel Margin="0,0,0,6">
                                    <local:InfoHint x:Name="InfoPresetLock" DockPanel.Dock="Right"/>
                                    <CheckBox x:Name="ChkPresetLock" Content="Hold color while the game runs" VerticalAlignment="Center"
                                              Checked="PresetEditorChanged" Unchecked="PresetEditorChanged"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPresetB" Text="Brightness" Style="{StaticResource SliderName}"/>
                                    <Slider Grid.Column="1" x:Name="SldPresetB" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                            IsSnapToTickEnabled="True" ValueChanged="PresetColor_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="ValPresetB" Style="{StaticResource SliderValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPresetC" Text="Contrast" Style="{StaticResource SliderName}"/>
                                    <Slider Grid.Column="1" x:Name="SldPresetC" Minimum="0" Maximum="2" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                            IsSnapToTickEnabled="True" ValueChanged="PresetColor_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="ValPresetC" Style="{StaticResource SliderValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPresetG" Text="Gamma" Style="{StaticResource SliderName}"/>
                                    <Slider Grid.Column="1" x:Name="SldPresetG" Minimum="0.5" Maximum="6" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.1"
                                            IsSnapToTickEnabled="True" ValueChanged="PresetColor_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="ValPresetG" Style="{StaticResource SliderValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPresetV" Text="Vibrance" Style="{StaticResource SliderName}"/>
                                    <Slider Grid.Column="1" x:Name="SldPresetV" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="5"
                                            IsSnapToTickEnabled="True" ValueChanged="PresetColor_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="ValPresetV" Style="{StaticResource SliderValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPresetH" Text="Hue" Style="{StaticResource SliderName}"/>
                                    <Slider Grid.Column="1" x:Name="SldPresetH" Minimum="0" Maximum="359" TickFrequency="1" SmallChange="1" LargeChange="10"
                                            IsSnapToTickEnabled="True" ValueChanged="PresetColor_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="ValPresetH" Style="{StaticResource SliderValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPresetShadow" Text="Shadows" Style="{StaticResource SliderName}"/>
                                    <Slider Grid.Column="1" x:Name="SldPresetShadow" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="5"
                                            IsSnapToTickEnabled="True" ValueChanged="PresetColor_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="ValPresetShadow" Style="{StaticResource SliderValue}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="LblPresetEditorEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================== MORE (Defaults + Log) ============================== -->
            <TabItem x:Name="TabMore" Header="More">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbMoreDefaults" GroupName="More" Style="{StaticResource SegmentRadio}"
                                     Content="Defaults" IsChecked="True" Checked="MoreSection_Checked"/>
                        <RadioButton x:Name="RbMoreLog" GroupName="More" Style="{StaticResource SegmentRadio}"
                                     Content="Log" Checked="MoreSection_Checked"/>
                    </StackPanel>
                    <Grid>
                        <!-- Defaults -->
                        <Border x:Name="PanelDefaults" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False" PanningMode="VerticalOnly">
                                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="20,16,24,16">
                                    <DockPanel>
                                        <Button x:Name="BtnApplyDefaults" DockPanel.Dock="Right" Content="Apply now"
                                                Style="{StaticResource CompactAccentButton}" HorizontalAlignment="Right" Click="ApplyDefaultsNow_Click"/>
                                        <TextBlock x:Name="LblDefaultsTitle" Text="Defaults" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="LblDefaultsHint" Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                                    <TextBlock x:Name="LblDefaultRes" Text="Resolution" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbDefaultRes" SelectionChanged="GlobalEditorChanged"/>
                                    <TextBlock x:Name="LblDefaultPower" Text="Power plan" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbDefaultPower" SelectionChanged="GlobalEditorChanged">
                                        <ComboBoxItem x:Name="ItmDefPowerKeep" Content="Don't change" Tag="" IsSelected="True"/>
                                        <ComboBoxItem x:Name="ItmDefPowerBalanced" Content="Balanced" Tag="balanced"/>
                                        <ComboBoxItem x:Name="ItmDefPowerHigh" Content="High performance" Tag="highPerformance"/>
                                    </ComboBox>

                                    <Separator/>
                                    <TextBlock x:Name="LblAppHotkeys" Text="App hotkeys" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LblAppHotkeysHint" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,10"/>
                                    <Grid x:Name="AppHotkeyGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="LblHkOverlay" Grid.Row="0" Text="Live overlay" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HkToggleOverlay" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk0" Grid.Row="0" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkToggleOverlay}"/>
                                        <TextBlock x:Name="LblHkEmergency" Grid.Row="1" Text="Reset display" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="HkEmergency" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk1" Grid.Row="1" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkEmergency}"/>
                                        <TextBlock x:Name="LblHkNext" Grid.Row="2" Text="Next preset" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="HkNextPreset" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk2" Grid.Row="2" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkNextPreset}"/>
                                        <TextBlock x:Name="LblHkPrev" Grid.Row="3" Text="Previous preset" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="HkPrevPreset" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk3" Grid.Row="3" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkPrevPreset}"/>
                                        <TextBlock x:Name="LblHkAb" Grid.Row="4" Text="A/B compare" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="HkCompareAb" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk4" Grid.Row="4" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkCompareAb}"/>
                                        <TextBlock x:Name="LblHkZoom" Grid.Row="5" Text="Zoom" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="HkToggleZoom" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk5" Grid.Row="5" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkToggleZoom}"/>
                                    </Grid>
                                    <TextBlock x:Name="LblZoomFactor" Text="Zoom factor" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                    <ComboBox x:Name="CmbZoomFactor" SelectionChanged="GlobalEditorChanged" MinWidth="160" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="×2" Tag="2"/>
                                        <ComboBoxItem Content="×3" Tag="3"/>
                                        <ComboBoxItem Content="×4" Tag="4" IsSelected="True"/>
                                        <ComboBoxItem Content="×6" Tag="6"/>
                                        <ComboBoxItem Content="×8" Tag="8"/>
                                        <ComboBoxItem Content="×10" Tag="10"/>
                                        <ComboBoxItem Content="×12" Tag="12"/>
                                    </ComboBox>
                                    <TextBlock x:Name="LblZoomHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="LblHotkeyCheat" Style="{StaticResource Hint}" Margin="0,10,0,0"/>

                                    <Separator Margin="0,16,0,12"/>
                                    <TextBlock x:Name="LblResetGlobalHint" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnReset" Content="Reset defaults" Style="{StaticResource DangerGhostButton}"
                                            HorizontalAlignment="Left" Click="ResetSettings_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Log -->
                        <DockPanel x:Name="PanelLog" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnLogRefresh" Content="Refresh" Style="{StaticResource CompactGhostButton}" Margin="0,0,8,0"
                                        HorizontalAlignment="Left" Click="RefreshLog_Click"/>
                                <Button x:Name="BtnLogFolder" Content="Open log" Style="{StaticResource CompactGhostButton}" Margin="0,0,12,0"
                                        HorizontalAlignment="Left" Click="OpenLogFolder_Click"/>
                                <CheckBox x:Name="ChkLogWrap" Content="Wrap lines" IsChecked="True" VerticalAlignment="Center"
                                          Checked="LogWrap_Changed" Unchecked="LogWrap_Changed"/>
                            </StackPanel>
                            <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}"
                                     Foreground="{DynamicResource TextBrush}"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Panic button sits on the tab strip line (top-right) -->
        <Button x:Name="BtnEmergency" Grid.Row="0" Content="Reset display" Style="{StaticResource DangerGhostButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top" MinHeight="30" Padding="12,5" Margin="0,-2,0,0"
                Click="EmergencyRestore_Click"/>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="TxtCredit" DockPanel.Dock="Right" Text="Nakidev · @nakidev"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" Cursor="Hand"
                       MouseLeftButtonUp="NakidevCredit_Click"/>
            <TextBlock x:Name="TxtShortcuts" Foreground="{DynamicResource MutedBrush}" FontSize="11" Opacity="0.8"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        </Grid><!-- content -->

        <!-- Non-modal toast / snackbar (optional Undo action) -->
        <Border x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,40" Padding="18,9,10,9" MaxWidth="560"
                Background="{DynamicResource ToastBgBrush}" BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1"
                CornerRadius="20" Opacity="0" Visibility="Collapsed"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Text=""
                           Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="0,0,8,0"/>
                <Button x:Name="ToastAction" Style="{StaticResource LinkButton}" FontSize="13" FontWeight="SemiBold"
                        VerticalAlignment="Center" Margin="4,0,4,0" Visibility="Collapsed" Click="ToastAction_Click"/>
            </StackPanel>
        </Border>

        <local:ScanOverlay x:Name="ScanBusy" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30"/>
        <local:EggOverlay x:Name="EggBusy" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="40"/>
    </Grid><!-- root -->
    </Border>
</Window>
