<Window x:Class="Visor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Visor"
        xmlns:controls="clr-namespace:Visor.Controls"
        Title="Visor"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Game tile used by the Play / Library lists -->
        <DataTemplate x:Key="GameTileTemplate">
            <Border CornerRadius="10" Padding="8,7" Background="{Binding TileBrush}" MinHeight="48"
                    ToolTip="{Binding ProcessName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="#33000000" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource InvNullToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                   Foreground="{Binding TileBrush, Converter={StaticResource TileFgMuted}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Compact tile (Presets tab game picker) -->
        <DataTemplate x:Key="GameTileCompactTemplate">
            <Border CornerRadius="10" Padding="8,6" Background="{Binding TileBrush}" MinHeight="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="6" Background="#33000000">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="11"
                                       Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource InvNullToVis}}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Game tiles announce the game name (the template is a colored card, not text). -->
        <Style x:Key="GameTileItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Card style lives in App.xaml (design-system token). -->
    </Window.Resources>

    <Border x:Name="ChromeRoot" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}" Opacity="0">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image x:Name="TitleLogo" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TitleAppName" Text="Visor" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="" Margin="12,0,0,0" FontSize="11"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Border x:Name="ActivePill" Margin="12,0,0,0" Padding="10,3" CornerRadius="10"
                        Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ActiveDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="ActiveHeaderText" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
                          Data="M0,4 L8,4"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
                          Data="M0.5,0.5 H7.5 V7.5 H0.5 Z" Fill="Transparent"/>
                </Button>
                <Button x:Name="BtnCloseCaption" Style="{StaticResource CaptionCloseButton}" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
                          Data="M1,1 L7,7 M7,1 L1,7"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentRoot" Grid.Row="1" Background="{DynamicResource BgBrush}"
              KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== SIDEBAR (Phase 2 shell) ============================== -->
        <Border Grid.Column="0" Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="0,10,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="VISOR" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" Margin="20,2,16,14"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- One Tab stop for the rail; arrows move between pages and wrap around. -->
                    <StackPanel x:Name="NavRail" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                        <TextBlock x:Name="LblNavMain" Text="MAIN" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="20,0,16,6"/>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavRailButton}" GroupName="ShellNav"
                                     Content="Home" IsChecked="True" Tag="home"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGames" Style="{StaticResource NavRailButton}" GroupName="ShellNav"
                                     Content="Games" Tag="games"
                                     Checked="Nav_Checked"
                                     PreviewMouseLeftButtonDown="NavGames_PreviewMouseLeftButtonDown"/>
                        <RadioButton x:Name="NavPresets" Style="{StaticResource NavRailButton}" GroupName="ShellNav"
                                     Content="Presets" Tag="presets"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavRailButton}" GroupName="ShellNav"
                                     Content="System" Tag="system"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Style="{StaticResource NavRailButton}" GroupName="ShellNav"
                                     Content="Network" Tag="network"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavRailButton}" GroupName="ShellNav"
                                     Content="Tools" Tag="tools"
                                     Checked="Nav_Checked"/>
                        <Button x:Name="NavSettings" Style="{StaticResource CompactGhostButton}"
                                Content="Settings" Margin="8,10,8,0" HorizontalAlignment="Stretch"
                                Click="Settings_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="8,12,8,0">
                    <Button x:Name="BtnPause" Style="{StaticResource CompactGhostButton}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,6"
                            Click="PauseMonitoring_Click"/>
                    <Button x:Name="BtnEmergency" Content="Reset display" Style="{StaticResource DangerGhostButton}"
                            HorizontalAlignment="Stretch" Click="EmergencyRestore_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="16,10,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblPageTitle" Grid.Row="0" Text="Home" Style="{StaticResource SectionTitle}"
                   AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8"/>

        <controls:ShellTabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource ShellTabControlStyle}">
            <!-- ============================== HOME ============================== -->
            <controls:ShellTabItem x:Name="TabHome" Header="">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,4,0,8">
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="LblHomeSession" Text="Session" Style="{StaticResource SubHeader}"/>
                                    <TextBlock x:Name="TxtHomeSessionStatus" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtHomeSessionDetail" Style="{StaticResource Hint}" Margin="0,6,0,12"/>
                                    <UniformGrid Columns="2">
                                        <Button x:Name="BtnHomePause" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,0,4,0" Click="PauseMonitoring_Click"/>
                                        <Button x:Name="BtnHomeEmergency" Style="{StaticResource DangerGhostButton}"
                                                Margin="4,0,0,0" Click="HomeEmergencyRestore_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="LblHomeDisplay" Text="Display" Style="{StaticResource SubHeader}"/>
                                    <TextBlock x:Name="TxtHomeDisplayMode" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtHomeGpu" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="LblHomeLibrary" Text="Library" Style="{StaticResource SubHeader}"/>
                                    <TextBlock x:Name="TxtHomeLibraryCounts" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <Button x:Name="BtnHomeScan" Content="Scan" Style="{StaticResource CompactAccentButton}"
                                                Margin="0,0,4,0" Click="ScanGames_Click"/>
                                        <Button x:Name="BtnHomeAdd" Content="Add" Style="{StaticResource CompactGhostButton}"
                                                Margin="4,0,0,0" Click="HomeAddGame_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="LblHomeHealth" Text="Visor status" Style="{StaticResource SubHeader}"/>
                                    <StackPanel x:Name="HomeHealthDots" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="LblHomeRec" Text="Suggestions" Style="{StaticResource SubHeader}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtHomeRecHint" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="HomeRecList"/>
                                <TextBlock x:Name="TxtHomeRecEmpty" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                                <Button x:Name="BtnHomeRecReset" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                        Margin="0,4,0,0" Visibility="Collapsed" Click="RecReset_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnHomeOpenGames" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                            Click="HomeOpenGames_Click"/>
                                    <TextBlock x:Name="LblHomeQuick" Text="Recent games" Style="{StaticResource SubHeader}" Margin="0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="HomeQuickList"/>
                                <TextBlock x:Name="TxtHomeQuickEmpty" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnHomeOpenHistory" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                            Click="HomeOpenHistory_Click"/>
                                    <TextBlock x:Name="LblHomeActivity" Text="Recent activity" Style="{StaticResource SubHeader}" Margin="0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="HomeActivityList"/>
                                <TextBlock x:Name="TxtHomeActivityEmpty" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </controls:ShellTabItem>

            <!-- ============================== GAMES (Play + Library) ============================== -->
            <controls:ShellTabItem x:Name="TabGames" Header="">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="TxtSearch" Margin="0,0,0,8" Padding="9,6" FontSize="12"
                                         VerticalContentAlignment="Center" TextChanged="Search_Changed"/>
                                <UniformGrid Columns="2">
                                    <Button x:Name="BtnScan" Content="Scan" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,4,0" Click="ScanGames_Click"/>
                                    <Button x:Name="BtnAddManual" Content="Add" Style="{StaticResource CompactGhostButton}"
                                            Margin="4,0,0,0" Click="AddProfile_Click"/>
                                </UniformGrid>
                            </StackPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button x:Name="BtnGamesListMore" DockPanel.Dock="Right" Content="..."
                                        Style="{StaticResource CompactGhostButton}" MinWidth="36" Padding="8,6"
                                        Click="GamesListMore_Click" ToolTip="More">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="MiDup" Header="Duplicate" Click="DupProfile_Click"/>
                                            <MenuItem x:Name="MiExportProfile" Header="Export" Click="ExportProfile_Click"/>
                                            <MenuItem x:Name="MiImportProfile" Header="Import" Click="ImportProfile_Click"/>
                                            <Separator/>
                                            <MenuItem x:Name="MiRestore" Header="Restore default games" Click="RestoreCoreGames_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource DangerGhostButton}"
                                        Margin="0,0,6,0" Click="DeleteProfile_Click"/>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged"
                                         ItemTemplate="{StaticResource GameTileTemplate}"
                                         ItemContainerStyle="{StaticResource GameTileItem}"/>
                                <StackPanel x:Name="LibraryEmpty" VerticalAlignment="Center" Margin="8" Visibility="Collapsed">
                                    <TextBlock x:Name="LblLibraryEmpty" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnLibraryEmptyAction" Style="{StaticResource CompactAccentButton}"
                                            HorizontalAlignment="Center" Click="LibraryEmptyAction_Click"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sticky actions. Below ~600 DIP the action group drops to a second row (see GamesHeader_SizeChanged). -->
                            <Grid x:Name="GamesHeader" Grid.Row="0" Margin="16,12,16,8" SizeChanged="GamesHeader_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtPlayName" Text="" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <Border x:Name="PlayStatusPill" DockPanel.Dock="Left" Background="{DynamicResource PillBgBrush}"
                                                CornerRadius="10" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" MaxWidth="180">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="PlayStatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="TxtPlayStatus" Text="" FontSize="11" Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtPlayProcess" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>
                                <WrapPanel x:Name="GamesHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="8,0,0,0">
                                    <CheckBox x:Name="ChkEnabled" Content="Enabled" VerticalAlignment="Center" Margin="0,0,10,4"
                                              Checked="EditorChanged" Unchecked="EditorChanged"/>
                                    <Button x:Name="BtnApplyProfileNow" Content="Apply now" Style="{StaticResource CompactGhostButton}"
                                            Margin="0,0,6,4" Click="ApplyProfileNow_Click"/>
                                    <Button x:Name="BtnLaunchGame" Content="Launch" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,6,4" MinWidth="88" Click="LaunchGame_Click"/>
                                    <Button x:Name="BtnGamesEditorMore" Content="..."
                                            Style="{StaticResource CompactGhostButton}" MinWidth="36" Padding="8,6" Margin="0,0,0,4"
                                            Click="GamesEditorMore_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="MiOverlay" Header="Live overlay" Click="Overlay_Click"/>
                                                <MenuItem x:Name="MiOpenPresets" Header="Edit presets" Click="OpenPresets_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                            </Grid>

                            <WrapPanel Grid.Row="1" Margin="16,0,16,8">
                                <RadioButton x:Name="RbGamesDisplay" GroupName="GamesEditor" Style="{StaticResource SegmentRadio}"
                                             Content="Display" IsChecked="True" Checked="GamesEditorSection_Checked"/>
                                <RadioButton x:Name="RbGamesColor" GroupName="GamesEditor" Style="{StaticResource SegmentRadio}"
                                             Content="Color" Checked="GamesEditorSection_Checked"/>
                                <RadioButton x:Name="RbGamesSession" GroupName="GamesEditor" Style="{StaticResource SegmentRadio}"
                                             Content="Session" Checked="GamesEditorSection_Checked"/>
                                <RadioButton x:Name="RbGamesCompanions" GroupName="GamesEditor" Style="{StaticResource SegmentRadio}"
                                             Content="Companions" Checked="GamesEditorSection_Checked"/>
                            </WrapPanel>

                            <Grid Grid.Row="2" Margin="0,0,0,0">
                                <!-- DISPLAY -->
                                <ScrollViewer x:Name="PanelGamesDisplay" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                                    <StackPanel x:Name="EditorPanel" Margin="20,4,20,16">
                                        <TextBlock x:Name="LblProfileTitle" Text="Game profile" Style="{StaticResource SectionTitle}"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock x:Name="LblName" Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtName" AutomationProperties.LabeledBy="{Binding ElementName=LblName}" TextChanged="EditorChanged"/>

                                        <TextBlock x:Name="LblProcess" Text="Game process (.exe)" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtProcess" Grid.Column="0" AutomationProperties.LabeledBy="{Binding ElementName=LblProcess}" TextChanged="EditorChanged"/>
                                            <Button x:Name="BtnBrowseExe" Grid.Column="1" Content="Browse" Style="{StaticResource CompactGhostButton}"
                                                    Margin="6,0,0,0" Click="BrowseExe_Click"/>
                                            <Button x:Name="BtnPickRunning" Grid.Column="2" Content="Running" Style="{StaticResource CompactGhostButton}"
                                                    Margin="6,0,0,0" Click="PickRunning_Click"/>
                                        </Grid>

                                        <Separator/>
                                        <TextBlock x:Name="LblDisplaySection" Text="Display" Style="{StaticResource SubHeader}"/>
                                        <CheckBox x:Name="ChkApplyRes" Content="Change resolution"
                                                  Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        <Grid x:Name="ResolutionPanel" Margin="24,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="LblResolution" Text="Resolution" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbResolution" Grid.Row="1" IsEditable="True"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=LblResolution}"
                                                      SelectionChanged="Resolution_Changed" LostFocus="Resolution_LostFocus"/>
                                            <TextBlock x:Name="LblRefreshRate" Grid.Column="2" Text="Refresh rate" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbRefreshRate" Grid.Column="2" Grid.Row="1" AutomationProperties.LabeledBy="{Binding ElementName=LblRefreshRate}" SelectionChanged="EditorChanged"/>
                                            <TextBlock x:Name="LblDisplay" Grid.Row="2" Grid.ColumnSpan="3" Text="Monitor" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="CmbDisplay" Grid.Row="3" Grid.ColumnSpan="3" AutomationProperties.LabeledBy="{Binding ElementName=LblDisplay}" SelectionChanged="Display_Changed"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkApplyPower" Content="Change power plan" Margin="0,12,0,4"
                                                  Checked="EditorChanged" Unchecked="EditorChanged"/>
                                        <ComboBox x:Name="CmbPower" Margin="24,4,0,0" AutomationProperties.LabeledBy="{Binding ElementName=ChkApplyPower}" SelectionChanged="EditorChanged">
                                            <ComboBoxItem x:Name="ItmPowerHigh" Content="High performance" Tag="highPerformance"/>
                                            <ComboBoxItem x:Name="ItmPowerBalanced" Content="Balanced" Tag="balanced"/>
                                        </ComboBox>

                                        <Separator/>
                                        <TextBlock x:Name="LblPresetsSection" Text="Presets" Style="{StaticResource SubHeader}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="LblColorSummary" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,6" LineHeight="18"/>
                                        <TextBlock x:Name="LblStartupPreset" Text="Startup preset" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                                        <ComboBox x:Name="CmbStartupPreset" AutomationProperties.LabeledBy="{Binding ElementName=LblStartupPreset}" SelectionChanged="EditorChanged"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- COLOR (former Play live color) -->
                                <ScrollViewer x:Name="PanelGamesColor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                                    <StackPanel x:Name="PlayEditor" Margin="20,4,20,16">
                                        <DockPanel Margin="0,0,0,4">
                                            <CheckBox x:Name="ChkPlayPreview" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                                      Content="Preview on desktop" Checked="PlayPreview_Changed" Unchecked="PlayPreview_Changed"/>
                                            <TextBlock x:Name="LblPlayColor" Text="Live color" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Border CornerRadius="10" Padding="10,7" Margin="0,4,0,12"
                                                Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <Ellipse x:Name="PlayHintDot" Width="7" Height="7" Margin="0,5,8,0" VerticalAlignment="Top"
                                                         Fill="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="LblPlayColorHint" Style="{StaticResource Hint}" FontSize="12"/>
                                            </DockPanel>
                                        </Border>

                                        <StackPanel x:Name="PlaySliders">
                                            <controls:ColorSliderRow x:Name="RowPlayB" Label="Brightness" Minimum="0" Maximum="1"
                                                                    Step="0.01" LargeChange="0.05" ValueChanged="PlaySlider_ValueChanged"/>
                                            <controls:ColorSliderRow x:Name="RowPlayC" Label="Contrast" Minimum="0" Maximum="2"
                                                                    Step="0.01" LargeChange="0.05" ValueChanged="PlaySlider_ValueChanged"/>
                                            <controls:ColorSliderRow x:Name="RowPlayG" Label="Gamma" Minimum="0.5" Maximum="6"
                                                                    Step="0.01" LargeChange="0.1" ValueChanged="PlaySlider_ValueChanged"/>
                                            <controls:ColorSliderRow x:Name="RowPlayV" Label="Vibrance" Minimum="0" Maximum="100"
                                                                    Step="1" LargeChange="5" ValueChanged="PlaySlider_ValueChanged"/>
                                            <controls:ColorSliderRow x:Name="RowPlayH" Label="Hue" Minimum="0" Maximum="359"
                                                                    Step="1" LargeChange="10" ValueChanged="PlaySlider_ValueChanged"/>
                                            <controls:ColorSliderRow x:Name="RowPlayS" Label="Shadows" Minimum="0" Maximum="100"
                                                                    Step="1" LargeChange="5" ValueChanged="PlaySlider_ValueChanged" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <DockPanel Margin="0,4,0,6">
                                            <Button x:Name="BtnPlayEditPreset" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                                    Click="PlayEditPreset_Click"/>
                                            <TextBlock x:Name="LblPlayPresets" Text="Presets" Style="{StaticResource SubHeader}" Margin="0"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <WrapPanel x:Name="PlayPresetChips" Margin="0,0,0,4"/>

                                        <Expander x:Name="ExpPlayHotkeys" Header="Hotkeys" IsExpanded="False" Margin="0,10,0,0">
                                            <TextBlock x:Name="TxtPlayHotkeys" Margin="2,0,0,0" Style="{StaticResource Hint}" FontSize="12"
                                                       LineHeight="20"/>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- SESSION -->
                                <ScrollViewer x:Name="PanelGamesSession" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                                    <StackPanel Margin="20,4,20,16">
                                        <Expander x:Name="ExpAdvanced" Header="Advanced" IsExpanded="True" Margin="0,0,0,8">
                                            <StackPanel Margin="2,0,0,0">
                                                <TextBlock x:Name="LblAliases" Text="Process aliases (comma-separated)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtAliases" AutomationProperties.LabeledBy="{Binding ElementName=LblAliases}" TextChanged="EditorChanged"/>
                                                <TextBlock x:Name="LblApplyDelay" Text="Apply delay: 0 s" Style="{StaticResource FieldLabel}"/>
                                                <Slider x:Name="SldApplyDelay" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=LblApplyDelay}"
                                                        SmallChange="1" LargeChange="10" ValueChanged="EditorSlider_ValueChanged"/>
                                                <CheckBox x:Name="ChkApplyOnFocus" Content="Wait for game window focus" Margin="0,4,0,0"
                                                          Checked="EditorChanged" Unchecked="EditorChanged"/>
                                                <DockPanel Margin="0,4,0,0">
                                                    <local:InfoHint x:Name="InfoSoftAltTab" DockPanel.Dock="Right"/>
                                                    <CheckBox x:Name="ChkSoftAltTab" Content="Soft restore on Alt-Tab" VerticalAlignment="Center"
                                                              Checked="EditorChanged" Unchecked="EditorChanged"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,10,0,4">
                                                    <local:InfoHint x:Name="InfoFpsLimit" DockPanel.Dock="Right"/>
                                                    <TextBlock x:Name="LblFpsLimit" Text="FPS limit (NVIDIA only)" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <ComboBox x:Name="CmbFpsLimit" IsEditable="True" AutomationProperties.LabeledBy="{Binding ElementName=LblFpsLimit}" SelectionChanged="EditorChanged" LostFocus="FpsLimit_LostFocus">
                                                    <ComboBoxItem x:Name="ItmFpsOff" Content="Off" Tag="0"/>
                                                    <ComboBoxItem Content="30" Tag="30"/>
                                                    <ComboBoxItem Content="60" Tag="60"/>
                                                    <ComboBoxItem Content="120" Tag="120"/>
                                                    <ComboBoxItem Content="144" Tag="144"/>
                                                    <ComboBoxItem Content="165" Tag="165"/>
                                                    <ComboBoxItem Content="240" Tag="240"/>
                                                </ComboBox>
                                                <TextBlock x:Name="LblFpsLimitHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                                <DockPanel Margin="0,12,0,4">
                                                    <local:InfoHint x:Name="InfoRestoreMode" DockPanel.Dock="Right"/>
                                                    <TextBlock x:Name="LblRestoreMode" Text="On game exit" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <ComboBox x:Name="CmbRestoreMode" AutomationProperties.LabeledBy="{Binding ElementName=LblRestoreMode}" SelectionChanged="EditorChanged">
                                                    <ComboBoxItem x:Name="ItmRestoreSnapshot" Tag="PreviousSnapshot"/>
                                                    <ComboBoxItem x:Name="ItmRestoreDefaults" Tag="GlobalDefaults"/>
                                                    <ComboBoxItem x:Name="ItmRestoreNothing" Tag="DoNothing"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Name="ExpSession" Header="Session extras" IsExpanded="True">
                                            <StackPanel Margin="2,0,0,0">
                                                <TextBlock x:Name="LblSessionSub" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="LblSessionTemplates" Text="Templates" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                                    <Button x:Name="BtnTplCompetitive" Content="Competitive" Style="{StaticResource CompactGhostButton}"
                                                            Margin="0,0,4,0" Click="SessionTemplateCompetitive_Click"/>
                                                    <Button x:Name="BtnTplImmersive" Content="Immersive" Style="{StaticResource CompactGhostButton}"
                                                            Margin="2,0,2,0" Click="SessionTemplateImmersive_Click"/>
                                                    <Button x:Name="BtnTplMinimal" Content="Minimal" Style="{StaticResource CompactGhostButton}"
                                                            Margin="4,0,0,0" Click="SessionTemplateMinimal_Click"/>
                                                </UniformGrid>
                                                <TextBlock x:Name="LblMonitorLayout" Text="Monitor layout" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                                                <ComboBox x:Name="CmbMonitorLayout" Margin="0,0,0,8" AutomationProperties.LabeledBy="{Binding ElementName=LblMonitorLayout}" SelectionChanged="EditorChanged">
                                                    <ComboBoxItem x:Name="ItmLayoutKeep" Tag="keepAll"/>
                                                    <ComboBoxItem x:Name="ItmLayoutIsolate" Tag="isolatePrimary"/>
                                                    <ComboBoxItem x:Name="ItmLayoutPrimary" Tag="primaryOnly"/>
                                                </ComboBox>
                                                <DockPanel>
                                                    <local:InfoHint x:Name="InfoDeferred" DockPanel.Dock="Right"/>
                                                    <TextBlock x:Name="LblDeferred" Text="Deferred re-apply: 0 s" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <Slider x:Name="SldDeferred" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=LblDeferred}"
                                                        SmallChange="1" LargeChange="5" ValueChanged="EditorSlider_ValueChanged"/>
                                                <DockPanel Margin="0,4,0,0">
                                                    <local:InfoHint x:Name="InfoQuiet" DockPanel.Dock="Right"/>
                                                    <CheckBox x:Name="ChkQuietToast" Content="Quiet notifications" VerticalAlignment="Center"
                                                              Checked="EditorChanged" Unchecked="EditorChanged"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,2,0,0">
                                                    <local:InfoHint x:Name="InfoHdr" DockPanel.Dock="Right"/>
                                                    <CheckBox x:Name="ChkNoAutoHdr" Content="Disable Auto HDR" VerticalAlignment="Center"
                                                              Checked="EditorChanged" Unchecked="EditorChanged"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,2,0,0">
                                                    <local:InfoHint x:Name="InfoMonBright" DockPanel.Dock="Right"/>
                                                    <CheckBox x:Name="ChkMonBright" Content="Set monitor brightness (DDC/CI)" VerticalAlignment="Center"
                                                              Checked="EditorChanged" Unchecked="EditorChanged"/>
                                                </DockPanel>
                                                <StackPanel x:Name="MonBrightPanel" Margin="24,0,0,0">
                                                    <TextBlock x:Name="LblMonBright" Text="Panel brightness: 80%" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                                    <Slider x:Name="SldMonBright" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=LblMonBright}"
                                                            SmallChange="1" LargeChange="5" ValueChanged="EditorSlider_ValueChanged"/>
                                                </StackPanel>
                                                <DockPanel Margin="0,6,0,0">
                                                    <local:InfoHint x:Name="InfoAudio" DockPanel.Dock="Right"/>
                                                    <CheckBox x:Name="ChkSwitchAudio" Content="Switch default audio device" VerticalAlignment="Center"
                                                              Checked="EditorChanged" Unchecked="EditorChanged"/>
                                                </DockPanel>
                                                <ComboBox x:Name="CmbAudio" Margin="24,4,0,0" AutomationProperties.LabeledBy="{Binding ElementName=ChkSwitchAudio}" SelectionChanged="EditorChanged"/>
                                                <DockPanel Margin="0,10,0,4">
                                                    <local:InfoHint x:Name="InfoScaling" DockPanel.Dock="Right"/>
                                                    <TextBlock x:Name="LblScaling" Text="Scaling mode" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <ComboBox x:Name="CmbScaling" AutomationProperties.LabeledBy="{Binding ElementName=LblScaling}" SelectionChanged="EditorChanged">
                                                    <ComboBoxItem x:Name="ItmScaleDefault" Tag="default"/>
                                                    <ComboBoxItem x:Name="ItmScaleStretch" Tag="stretch"/>
                                                    <ComboBoxItem x:Name="ItmScaleCenter" Tag="center"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- COMPANIONS -->
                                <ScrollViewer x:Name="PanelGamesCompanions" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                                    <StackPanel Margin="20,4,20,16">
                                        <DockPanel Margin="0,0,0,8">
                                            <local:InfoHint x:Name="InfoCompanions" DockPanel.Dock="Right"/>
                                            <TextBlock x:Name="LblCompanions" Text="Companion apps" Style="{StaticResource SubHeader}" Margin="0"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Grid>
                                            <ListBox x:Name="CompanionList" MinHeight="120" MaxHeight="280"
                                                     SelectionChanged="CompanionList_SelectionChanged"
                                                     MouseDoubleClick="CompanionList_MouseDoubleClick">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                        <Setter Property="Padding" Value="10,6"/>
                                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource CompanionLabel}}"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource CompanionLabel}}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Path}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="LblCompanionsEmpty" Style="{StaticResource Hint}" Margin="4,8" IsHitTestVisible="False"/>
                                        </Grid>
                                        <UniformGrid Columns="3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <Button x:Name="BtnCompanionAdd" Content="Add" Style="{StaticResource CompactGhostButton}" Margin="0,0,6,0"
                                                    MinWidth="72" Click="AddCompanion_Click"/>
                                            <Button x:Name="BtnCompanionEdit" Content="Edit" Style="{StaticResource CompactGhostButton}" Margin="0,0,6,0"
                                                    MinWidth="72" IsEnabled="False" Click="EditCompanion_Click"/>
                                            <Button x:Name="BtnCompanionRemove" Content="Remove" Style="{StaticResource DangerGhostButton}"
                                                    MinWidth="72" IsEnabled="False" Click="RemoveCompanion_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBlock x:Name="LblEditorEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </controls:ShellTabItem>

            <!-- ============================== PRESETS ============================== -->
            <controls:ShellTabItem x:Name="TabPresets" Header="">
                <!-- Columns share the width (min 170 / 200 / 300). Below ~760 DIP the game column collapses
                     into CmbPresetGame above the preset list (see PresetsPage_SizeChanged). -->
                <Grid x:Name="PresetsPage" Margin="0,10,0,0" SizeChanged="PresetsPage_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColPresetGames" Width="2*" MinWidth="170"/>
                        <ColumnDefinition x:Name="ColPresetGamesGap" Width="12"/>
                        <ColumnDefinition Width="2.5*" MinWidth="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="4*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PresetGamesCard" Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock x:Name="LblPresetGamePick" DockPanel.Dock="Top" Text="Game" Style="{StaticResource SubHeader}"/>
                            <ListBox x:Name="PresetGameList" SelectionChanged="PresetGameList_SelectionChanged"
                                     ItemTemplate="{StaticResource GameTileCompactTemplate}"
                                     ItemContainerStyle="{StaticResource GameTileItem}"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <ComboBox x:Name="CmbPresetGame" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed"
                                      DisplayMemberPath="Name" SelectionChanged="PresetGameCombo_SelectionChanged"/>
                            <TextBlock DockPanel.Dock="Top" x:Name="LblPresetGame" Text="Presets"
                                       Style="{StaticResource SubHeader}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button x:Name="BtnPresetAdd" Content="Add" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,4,0" Click="AddPreset_Click"/>
                                    <Button x:Name="BtnPresetDelete" Content="Delete" Style="{StaticResource DangerGhostButton}"
                                            Margin="4,0,0,0" Click="DeletePreset_Click"/>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button x:Name="BtnPresetExport" Content="Export" Style="{StaticResource CompactGhostButton}"
                                            Margin="0,0,4,0" Click="ExportPresets_Click"/>
                                    <Button x:Name="BtnPresetImport" Content="Import" Style="{StaticResource CompactGhostButton}"
                                            Margin="4,0,0,0" Click="ImportPresets_Click"/>
                                </UniformGrid>
                                <Button x:Name="BtnPackGallery" Content="Pack gallery" Style="{StaticResource CompactGhostButton}"
                                        Click="PackGallery_Click"/>
                            </StackPanel>
                            <Grid>
                                <ListBox x:Name="PresetList" SelectionChanged="PresetList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Converter={StaticResource PresetSummary}}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                            Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" VerticalAlignment="Center"
                                                            Visibility="{Binding Hotkey, Converter={StaticResource NullToVis}}">
                                                        <TextBlock Text="{Binding Hotkey}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource MutedBrush}" MaxWidth="110"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Converter={StaticResource PresetSummary}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="PresetEmptyCta" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Margin="12" Visibility="Collapsed">
                                    <TextBlock x:Name="LblPresetEmpty" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnPresetEmptyGallery" Style="{StaticResource CompactAccentButton}"
                                            HorizontalAlignment="Center" Click="PackGallery_Click"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <Grid>
                        <Grid x:Name="PresetEditor">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Pinned: stays visible while the editor body scrolls. -->
                            <DockPanel Grid.Row="0" Margin="20,16,20,6">
                                <Button x:Name="BtnApplyPreset" DockPanel.Dock="Right" Content="Apply now"
                                        Style="{StaticResource CompactAccentButton}" HorizontalAlignment="Right" Click="ApplyPresetNow_Click"/>
                                <TextBlock x:Name="LblPresetEditorTitle" Text="Preset" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" PanningMode="VerticalOnly">
                            <StackPanel Margin="20,0,20,16">
                                <TextBlock x:Name="LblPresetName" Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPresetName" AutomationProperties.LabeledBy="{Binding ElementName=LblPresetName}"
                                         TextChanged="PresetName_TextChanged" LostFocus="PresetName_LostFocus"/>

                                <TextBlock x:Name="LblPresetHotkey" Text="Hotkey" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPresetHotkey" AutomationProperties.LabeledBy="{Binding ElementName=LblPresetHotkey}" IsReadOnly="True" Cursor="Hand"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                             GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                    <Button x:Name="BtnPresetHotkeyClear" Grid.Column="1" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                            Margin="6,0,0,0" Click="ClearHotkey_Click" Tag="{Binding ElementName=TxtPresetHotkey}"/>
                                </Grid>
                                <TextBlock x:Name="LblPresetHotkeyHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                                <CheckBox x:Name="ChkPresetRes" Content="Set resolution" Margin="0,12,0,4"
                                          Checked="PresetEditorChanged" Unchecked="PresetEditorChanged"/>
                                <ComboBox x:Name="CmbPresetRes" Margin="24,2,0,0" AutomationProperties.LabeledBy="{Binding ElementName=ChkPresetRes}" SelectionChanged="PresetEditorChanged"/>

                                <Separator/>
                                <TextBlock x:Name="LblPresetColor" Text="Color" Style="{StaticResource SubHeader}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="LblPresetColorHint" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,6">
                                    <local:InfoHint x:Name="InfoPresetBackend" DockPanel.Dock="Right"/>
                                    <TextBlock x:Name="LblPresetBackend" Text="Color method" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ToggleButton x:Name="TogPresetBackend" Style="{StaticResource BackendSlideToggle}"
                                              Content="NVIDIA" Checked="PresetBackendToggle_Changed" Unchecked="PresetBackendToggle_Changed"/>
                                <TextBlock x:Name="LblPresetBackendActive" Style="{StaticResource Hint}" Margin="2,6,0,6"/>
                                <DockPanel Margin="0,0,0,6">
                                    <local:InfoHint x:Name="InfoPresetLock" DockPanel.Dock="Right"/>
                                    <CheckBox x:Name="ChkPresetLock" Content="Hold color while the game runs" VerticalAlignment="Center"
                                              Checked="PresetEditorChanged" Unchecked="PresetEditorChanged"/>
                                </DockPanel>

                                <controls:ColorSliderRow x:Name="RowPresetB" Label="Brightness" Minimum="0" Maximum="1"
                                                        Step="0.01" LargeChange="0.05" ValueChanged="PresetColor_ValueChanged"/>
                                <controls:ColorSliderRow x:Name="RowPresetC" Label="Contrast" Minimum="0" Maximum="2"
                                                        Step="0.01" LargeChange="0.05" ValueChanged="PresetColor_ValueChanged"/>
                                <controls:ColorSliderRow x:Name="RowPresetG" Label="Gamma" Minimum="0.5" Maximum="6"
                                                        Step="0.01" LargeChange="0.1" ValueChanged="PresetColor_ValueChanged"/>
                                <controls:ColorSliderRow x:Name="RowPresetV" Label="Vibrance" Minimum="0" Maximum="100"
                                                        Step="1" LargeChange="5" ValueChanged="PresetColor_ValueChanged"/>
                                <controls:ColorSliderRow x:Name="RowPresetH" Label="Hue" Minimum="0" Maximum="359"
                                                        Step="1" LargeChange="10" ValueChanged="PresetColor_ValueChanged"/>
                                <controls:ColorSliderRow x:Name="RowPresetShadow" Label="Shadows" Minimum="0" Maximum="100"
                                                        Step="1" LargeChange="5" ValueChanged="PresetColor_ValueChanged"/>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                        <TextBlock x:Name="LblPresetEditorEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
                        </Grid>
                    </Border>
                </Grid>
            </controls:ShellTabItem>

            <!-- ============================== SYSTEM (PC overview + safe actions) ============================== -->
            <controls:ShellTabItem x:Name="TabSystem" Header="">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,4,0,8">
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="BtnSystemRefresh" DockPanel.Dock="Right" Style="{StaticResource CompactGhostButton}"
                                    Click="SystemRefresh_Click"/>
                            <TextBlock x:Name="LblSystemOverview" Text="Overview" Style="{StaticResource SubHeader}"
                                       VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Style="{StaticResource Card}" Margin="0,0,6,6" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="LblSystemCpu" Text="CPU" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtSystemCpu" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,0,6" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="LblSystemRam" Text="Memory" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtSystemRam" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="LblSystemGpu" Text="GPU" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtSystemGpu" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="LblSystemOs" Text="Windows" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="TxtSystemOs" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="LblSystemDisks" Text="Storage" Style="{StaticResource SubHeader}" Margin="0,0,0,6"/>
                                <StackPanel x:Name="SystemDiskList"/>
                                <TextBlock x:Name="TxtSystemDisksEmpty" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="LblSystemSafe" Text="Safe Windows tweaks" Style="{StaticResource SubHeader}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSystemSafeHint" Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="BtnGameModeToggle" Style="{StaticResource CompactAccentButton}"
                                                Margin="0,0,6,0" Click="GameModeToggle_Click"/>
                                        <Button x:Name="BtnGameModeRollback" Style="{StaticResource CompactGhostButton}"
                                                Click="GameModeRollback_Click" IsEnabled="False"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="LblGameMode" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="TxtGameModeStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="BtnPowerHighPerf" Style="{StaticResource CompactAccentButton}"
                                                Margin="0,0,6,0" Click="PowerHighPerf_Click"/>
                                        <Button x:Name="BtnPowerRollback" Style="{StaticResource CompactGhostButton}"
                                                Click="PowerRollback_Click" IsEnabled="False"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="LblPowerPlan" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="TxtPowerPlanStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button x:Name="BtnProcessRefresh" DockPanel.Dock="Right" Style="{StaticResource CompactGhostButton}"
                                            Click="ProcessRefresh_Click"/>
                                    <TextBlock x:Name="LblSystemProcesses" Text="Background processes" Style="{StaticResource SubHeader}"
                                               VerticalAlignment="Center" Margin="0"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtProcessHint" DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtProcessEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                           Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <ListBox x:Name="ProcessList" MaxHeight="280">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </controls:ShellTabItem>

            <!-- ============================== NETWORK ============================== -->
            <controls:ShellTabItem x:Name="TabNetwork" Header="">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,4,0,8">
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="BtnNetRefresh" DockPanel.Dock="Right" Style="{StaticResource CompactGhostButton}"
                                    Click="NetRefresh_Click"/>
                            <TextBlock x:Name="LblNetOverview" Text="Adapter" Style="{StaticResource SubHeader}"
                                       VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtNetAdapter" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtNetDetails" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtNetDns" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtNetEmpty" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="LblNetLatency" Text="Latency probe" Style="{StaticResource SubHeader}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtNetLatencyHint" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="LblNetHost" DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                                    <ComboBox x:Name="CmbNetHost" MinWidth="160" HorizontalAlignment="Left"
                                              AutomationProperties.LabeledBy="{Binding ElementName=LblNetHost}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BtnNetPingStart" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,8,0" Click="NetPingStart_Click"/>
                                    <Button x:Name="BtnNetPingStop" Style="{StaticResource CompactGhostButton}"
                                            Click="NetPingStop_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtNetPingSummary" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtNetPingDetail" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtNetJitterNote" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="LblNetDns" Text="DNS resolve" Style="{StaticResource SubHeader}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtNetDnsHint" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BtnNetDns" Style="{StaticResource CompactAccentButton}"
                                            Margin="0,0,8,0" Click="NetDns_Click"/>
                                    <Button x:Name="BtnNetDnsStop" Style="{StaticResource CompactGhostButton}"
                                            Click="NetDnsStop_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtNetDnsStatus" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>
                                <StackPanel x:Name="NetDnsResults"/>
                                <TextBlock x:Name="TxtNetDnsEmpty" Style="{StaticResource Hint}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </controls:ShellTabItem>

            <!-- ============================== MORE (Defaults + Log) ============================== -->
            <controls:ShellTabItem x:Name="TabMore" Header="">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbMoreDefaults" GroupName="More" Style="{StaticResource SegmentRadio}"
                                     Content="Defaults" IsChecked="True" Checked="MoreSection_Checked"/>
                        <RadioButton x:Name="RbMoreHistory" GroupName="More" Style="{StaticResource SegmentRadio}"
                                     Content="History" Checked="MoreSection_Checked"/>
                        <RadioButton x:Name="RbMoreLog" GroupName="More" Style="{StaticResource SegmentRadio}"
                                     Content="Log" Checked="MoreSection_Checked"/>
                    </StackPanel>
                    <Grid>
                        <!-- Defaults -->
                        <Border x:Name="PanelDefaults" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False" PanningMode="VerticalOnly">
                                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="20,16,24,16">
                                    <DockPanel>
                                        <Button x:Name="BtnApplyDefaults" DockPanel.Dock="Right" Content="Apply now"
                                                Style="{StaticResource CompactAccentButton}" HorizontalAlignment="Right" Click="ApplyDefaultsNow_Click"/>
                                        <TextBlock x:Name="LblDefaultsTitle" Text="Defaults" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="LblDefaultsHint" Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                                    <TextBlock x:Name="LblDefaultRes" Text="Resolution" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbDefaultRes" AutomationProperties.LabeledBy="{Binding ElementName=LblDefaultRes}" SelectionChanged="GlobalEditorChanged"/>
                                    <TextBlock x:Name="LblDefaultPower" Text="Power plan" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbDefaultPower" AutomationProperties.LabeledBy="{Binding ElementName=LblDefaultPower}" SelectionChanged="GlobalEditorChanged">
                                        <ComboBoxItem x:Name="ItmDefPowerKeep" Content="Don't change" Tag="" IsSelected="True"/>
                                        <ComboBoxItem x:Name="ItmDefPowerBalanced" Content="Balanced" Tag="balanced"/>
                                        <ComboBoxItem x:Name="ItmDefPowerHigh" Content="High performance" Tag="highPerformance"/>
                                    </ComboBox>

                                    <Separator/>
                                    <TextBlock x:Name="LblAppHotkeys" Text="App hotkeys" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LblAppHotkeysHint" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="LblHkOverlay" Grid.Row="0" Text="Live overlay" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HkToggleOverlay" AutomationProperties.LabeledBy="{Binding ElementName=LblHkOverlay}" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk0" Grid.Row="0" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkToggleOverlay}"/>
                                        <TextBlock x:Name="LblHkEmergency" Grid.Row="1" Text="Reset display" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="HkEmergency" AutomationProperties.LabeledBy="{Binding ElementName=LblHkEmergency}" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk1" Grid.Row="1" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkEmergency}"/>
                                        <TextBlock x:Name="LblHkNext" Grid.Row="2" Text="Next preset" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="HkNextPreset" AutomationProperties.LabeledBy="{Binding ElementName=LblHkNext}" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk2" Grid.Row="2" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkNextPreset}"/>
                                        <TextBlock x:Name="LblHkPrev" Grid.Row="3" Text="Previous preset" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="HkPrevPreset" AutomationProperties.LabeledBy="{Binding ElementName=LblHkPrev}" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk3" Grid.Row="3" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkPrevPreset}"/>
                                        <TextBlock x:Name="LblHkAb" Grid.Row="4" Text="A/B compare" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="HkCompareAb" AutomationProperties.LabeledBy="{Binding ElementName=LblHkAb}" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk4" Grid.Row="4" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkCompareAb}"/>
                                        <TextBlock x:Name="LblHkZoom" Grid.Row="5" Text="Zoom" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="HkToggleZoom" AutomationProperties.LabeledBy="{Binding ElementName=LblHkZoom}" Margin="0,4,8,4" IsReadOnly="True" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewMouseDown="HotkeyBox_PreviewMouseDown"
                                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                                        <Button x:Name="BtnClearHk5" Grid.Row="5" Grid.Column="2" Content="Clear" Style="{StaticResource CompactGhostButton}"
                                                Margin="0,4,0,4" Click="ClearHotkey_Click" Tag="{Binding ElementName=HkToggleZoom}"/>
                                    </Grid>
                                    <TextBlock x:Name="LblZoomFactor" Text="Zoom factor" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                    <ComboBox x:Name="CmbZoomFactor" AutomationProperties.LabeledBy="{Binding ElementName=LblZoomFactor}" SelectionChanged="GlobalEditorChanged" MinWidth="160" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="x2" Tag="2"/>
                                        <ComboBoxItem Content="x3" Tag="3"/>
                                        <ComboBoxItem Content="x4" Tag="4" IsSelected="True"/>
                                        <ComboBoxItem Content="x6" Tag="6"/>
                                        <ComboBoxItem Content="x8" Tag="8"/>
                                        <ComboBoxItem Content="x10" Tag="10"/>
                                        <ComboBoxItem Content="x12" Tag="12"/>
                                    </ComboBox>
                                    <TextBlock x:Name="LblZoomHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="LblHotkeyCheat" Style="{StaticResource Hint}" Margin="0,10,0,0"/>

                                    <Separator Margin="0,16,0,12"/>
                                    <TextBlock x:Name="LblResetGlobalHint" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnReset" Content="Reset defaults" Style="{StaticResource DangerGhostButton}"
                                            HorizontalAlignment="Left" Click="ResetSettings_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- History -->
                        <DockPanel x:Name="PanelHistory" Visibility="Collapsed">
                            <TextBlock x:Name="LblHistoryHint" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                            <Grid>
                                <ListBox x:Name="HistoryList">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="TxtHistoryEmpty" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>

                        <!-- Log -->
                        <DockPanel x:Name="PanelLog" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnLogRefresh" Content="Refresh" Style="{StaticResource CompactGhostButton}" Margin="0,0,8,0"
                                        HorizontalAlignment="Left" Click="RefreshLog_Click"/>
                                <Button x:Name="BtnLogFolder" Content="Open log" Style="{StaticResource CompactGhostButton}" Margin="0,0,12,0"
                                        HorizontalAlignment="Left" Click="OpenLogFolder_Click"/>
                                <CheckBox x:Name="ChkLogWrap" Content="Wrap lines" IsChecked="True" VerticalAlignment="Center"
                                          Checked="LogWrap_Changed" Unchecked="LogWrap_Changed"/>
                            </StackPanel>
                            <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     FontFamily="Consolas" FontSize="12" Background="{DynamicResource FieldBrush}"
                                     Foreground="{DynamicResource TextBrush}"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </controls:ShellTabItem>
        </controls:ShellTabControl>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="TxtCredit" DockPanel.Dock="Right" Text="Nakidev · @nakidev"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" Cursor="Hand"
                       MouseLeftButtonUp="NakidevCredit_Click"/>
            <TextBlock x:Name="TxtShortcuts" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        </Grid><!-- main column -->
        </Grid><!-- content -->

        <!-- Non-modal toast / snackbar (optional Undo action) -->
        <Border x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,40" Padding="18,9,10,9" MaxWidth="560"
                Background="{DynamicResource ToastBgBrush}" BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1"
                CornerRadius="20" Opacity="0" Visibility="Collapsed"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Text="" AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="0,0,8,0"/>
                <Button x:Name="ToastAction" Style="{StaticResource LinkButton}" FontSize="13" FontWeight="SemiBold"
                        VerticalAlignment="Center" Margin="4,0,4,0" Visibility="Collapsed" Click="ToastAction_Click"/>
            </StackPanel>
        </Border>

        <local:ScanOverlay x:Name="ScanBusy" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30"/>
        <local:EggOverlay x:Name="EggBusy" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="40"/>
    </Grid><!-- root -->
    </Border>
</Window>
