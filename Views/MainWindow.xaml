<Window x:Class="Visor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Visor"
        xmlns:controls="clr-namespace:Visor.Controls"
        Title="Visor"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Pulse / frametime graph for the Monitor section (kept here so App.xaml stays untouched). -->
        <Geometry x:Key="IconMonitor">M3,13H5.5L8,6L11,18L14,9L16,13H21V11H17.2L14,4.5L11,15L8,2L4.3,11H3V13Z</Geometry>
    </Window.Resources>

    <!-- Shell only: chrome, nav rail, top bar, page host, toasts. Pages live in Views\Pages. -->
    <Border x:Name="ChromeRoot" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}" Opacity="0">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image x:Name="TitleLogo" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TitleAppName" Text="Visor" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="" Margin="12,0,0,0" FontSize="11"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Border x:Name="ActivePill" Margin="12,0,0,0" Padding="10,3" CornerRadius="10"
                        Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:StatusDot x:Name="ActiveDot" Width="7" Height="7" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ActiveHeaderText" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" Data="M0,4 L8,4"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
                          Data="M0.5,0.5 H7.5 V7.5 H0.5 Z" Fill="Transparent"/>
                </Button>
                <Button x:Name="BtnCloseCaption" Style="{StaticResource CaptionCloseButton}" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" Data="M1,1 L7,7 M7,1 L1,7"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentRoot" Grid.Row="1" Background="{DynamicResource BgBrush}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================== NAV RAIL ============================== -->
            <Border x:Name="NavRailPanel" Grid.Column="0" Width="200" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0,10,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand + collapse -->
                    <DockPanel Grid.Row="0" Margin="12,2,8,14">
                        <Button x:Name="BtnRailCollapse" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                Width="28" Height="28" Click="RailCollapse_Click">
                            <Path x:Name="RailCollapseIcon" Width="14" Height="14" Stretch="Uniform"
                                  Data="{StaticResource IconCollapse}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <StackPanel x:Name="BrandRow" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="RailLogo" Width="22" Height="22" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="LblBrand" Text="Visor" FontSize="15" FontWeight="Bold" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="BetaPill" Margin="6,1,0,0" Padding="6,1" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock x:Name="LblBeta" Text="beta" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- One Tab stop for the rail; arrows move between pages and wrap around. -->
                        <StackPanel x:Name="NavRail" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <TextBlock x:Name="LblNavMain" Text="MAIN" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="20,0,16,6"/>
                            <controls:NavRailItem x:Name="NavHome" GroupName="ShellNav" Tag="home" IsChecked="True"
                                                  Icon="{StaticResource IconHome}" Shortcut="Ctrl+1" Checked="Nav_Checked"/>
                            <controls:NavRailItem x:Name="NavMyPc" GroupName="ShellNav" Tag="mypc"
                                                  Icon="{StaticResource IconMyPc}" Shortcut="Ctrl+2" Checked="Nav_Checked"/>
                            <controls:NavRailItem x:Name="NavGames" GroupName="ShellNav" Tag="games"
                                                  Icon="{StaticResource IconGames}" Shortcut="Ctrl+3" Checked="Nav_Checked"
                                                  PreviewMouseLeftButtonDown="NavGames_PreviewMouseLeftButtonDown"/>
                            <controls:NavRailItem x:Name="NavOptimize" GroupName="ShellNav" Tag="optimize"
                                                  Icon="{StaticResource IconOptimize}" Shortcut="Ctrl+4" Checked="Nav_Checked"/>
                            <controls:NavRailItem x:Name="NavNetwork" GroupName="ShellNav" Tag="network"
                                                  Icon="{StaticResource IconNetwork}" Shortcut="Ctrl+5" Checked="Nav_Checked"/>
                            <controls:NavRailItem x:Name="NavMonitor" GroupName="ShellNav" Tag="monitor"
                                                  Icon="{StaticResource IconMonitor}" Shortcut="Ctrl+6" Checked="Nav_Checked"/>
                            <controls:NavRailItem x:Name="NavSettings" GroupName="ShellNav" Tag="settings"
                                                  Icon="{StaticResource IconSettings}" Shortcut="Ctrl+7" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Themes + help -->
                    <StackPanel x:Name="RailFooter" Grid.Row="2" Margin="12,12,12,0">
                        <DockPanel Margin="0,0,0,10">
                            <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                  Data="{StaticResource IconThemes}" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbRailTheme" MinHeight="30" Padding="8,4" FontSize="12"
                                      SelectionChanged="RailTheme_Changed">
                                <ComboBoxItem x:Name="ItmThemeDark" Tag="dark"/>
                                <ComboBoxItem x:Name="ItmThemeLight" Tag="light"/>
                                <ComboBoxItem x:Name="ItmThemeCustom" Tag="custom"/>
                            </ComboBox>
                        </DockPanel>
                        <Border x:Name="HelpCard" Style="{StaticResource CardSurface}" Padding="12,10">
                            <StackPanel>
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                          Data="{StaticResource IconHelp}" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblHelpTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="LblHelpBody" Style="{StaticResource CardCaption}" Margin="0,6,0,8"/>
                                <Button x:Name="BtnHelpLink" Style="{StaticResource CompactGhostButton}" HorizontalAlignment="Stretch"
                                        Click="HelpLink_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== MAIN COLUMN ============================== -->
            <Grid Grid.Column="1" Margin="16,8,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar: machine caption + page title · tooltip mode · gear -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="TogTooltipMode" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                      Checked="TooltipMode_Changed" Unchecked="TooltipMode_Changed"/>
                        <Button x:Name="BtnTopSettings" Style="{StaticResource IconButton}" Margin="12,0,0,0" Click="Settings_Click">
                            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconSettings}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LblMachine" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LblPageTitle" Text="Home" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" AutomationProperties.HeadingLevel="Level1"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </DockPanel>

                <!-- Page host (content assigned in code: Home · My PC · Games · Optimize · Network · Monitor · Settings) -->
                <controls:ShellTabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource ShellTabControlStyle}">
                    <controls:ShellTabItem x:Name="TabHome" Header=""/>
                    <controls:ShellTabItem x:Name="TabMyPc" Header=""/>
                    <controls:ShellTabItem x:Name="TabGames" Header=""/>
                    <controls:ShellTabItem x:Name="TabOptimize" Header=""/>
                    <controls:ShellTabItem x:Name="TabNetwork" Header=""/>
                    <controls:ShellTabItem x:Name="TabMonitor" Header=""/>
                    <controls:ShellTabItem x:Name="TabSettings" Header=""/>
                </controls:ShellTabControl>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtCredit" DockPanel.Dock="Right" Text="Nakidev · @nakidev"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonUp="NakidevCredit_Click"/>
                    <TextBlock x:Name="TxtShortcuts" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Non-modal toast / snackbar (optional Undo action) -->
        <Border x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,40" Padding="18,9,10,9" MaxWidth="560"
                Background="{DynamicResource ToastBgBrush}" BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1"
                CornerRadius="20" Opacity="0" Visibility="Collapsed"
                Panel.ZIndex="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Text="" AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="0,0,8,0"/>
                <Button x:Name="ToastAction" Style="{StaticResource LinkButton}" FontSize="13" FontWeight="SemiBold"
                        VerticalAlignment="Center" Margin="4,0,4,0" Visibility="Collapsed" Click="ToastAction_Click"/>
            </StackPanel>
        </Border>

        <local:ScanOverlay x:Name="ScanBusyOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="30"/>
        <local:EggOverlay x:Name="EggBusy" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="40"/>
    </Grid>
    </Border>
</Window>
