<Window x:Class="Visor.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Command palette" Height="420" Width="520"
        MinHeight="320" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="ChromeRoot" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource PanelBrush}" CornerRadius="12" Opacity="0">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TxtFilter" Padding="12,10" FontSize="14"
                     TextChanged="TxtFilter_TextChanged"
                     PreviewKeyDown="TxtFilter_PreviewKeyDown"/>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <ListBox x:Name="CmdList" MouseDoubleClick="CmdList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Group}" FontSize="10" Opacity="0.75"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Visibility="{Binding Group, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
            </Grid>

            <TextBlock Grid.Row="2" x:Name="TxtHint" Margin="2,10,2,0" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" Opacity="0.85"/>
        </Grid>
    </Border>
</Window>
