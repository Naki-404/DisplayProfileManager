<Window x:Class="Visor.GameOverlayWindow"
        UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visor Live"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Grid>
        <!-- Compact pill -->
        <Border x:Name="MiniPill" CornerRadius="22" Padding="8,5" Cursor="Hand"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                MouseLeftButtonDown="MiniPill_MouseDown">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource BrandGradientBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMini" Text="Visor" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource TextBrush}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                <!-- Vector chevrons: the ◀ ▶ text glyphs come from font fallback and sit off-center. -->
                <Button x:Name="BtnMiniPrev" Width="26" Height="26" Padding="0"
                        Style="{StaticResource CaptionButton}" Click="PrevPreset_Click">
                    <Path Width="5" Height="9" Stretch="Uniform" Data="M4,0 L0,4 L4,8" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="BtnMiniNext" Width="26" Height="26" Padding="0"
                        Style="{StaticResource CaptionButton}" Click="NextPreset_Click">
                    <Path Width="5" Height="9" Stretch="Uniform" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="BtnMiniAb" Content="A/B" Width="30" Height="26" FontSize="9" Padding="0" Margin="2,0,0,0"
                        Style="{StaticResource CaptionButton}" Click="Ab_Click"/>
            </StackPanel>
        </Border>

        <!-- Expanded panel -->
        <!-- Shadow on a sibling layer (an Effect on the panel itself would rasterize all of its text). -->
        <Grid x:Name="PanelRoot" Visibility="Collapsed" MinWidth="300" MaxWidth="320">
            <Border CornerRadius="12" Background="{DynamicResource BgBrush}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="12"
                    Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <StackPanel Margin="12,10,12,12">
                <Grid Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="Live color" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="TxtContext" Text="" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                        <TextBlock x:Name="TxtPreset" Text="" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Same vector glyphs as the main window caption (text "—" / "×" sat off-center). -->
                        <Button x:Name="BtnCollapse" Style="{StaticResource CaptionButton}"
                                Width="28" Height="28" Click="Collapse_Click">
                            <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1" Data="M0,4 L8,4"/>
                        </Button>
                        <Button x:Name="BtnHide" Style="{StaticResource CaptionCloseButton}"
                                Width="28" Height="28" Margin="4,0,0,0" Click="Hide_Click">
                            <Path Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1.2" Data="M1,1 L9,9 M9,1 L1,9"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="LblLiveHint" Text=""
                           FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <ToggleButton x:Name="TogBackend" Style="{StaticResource BackendSlideToggle}"
                              Content="NVIDIA" Margin="0,0,0,8"
                              Checked="Backend_Changed" Unchecked="Backend_Changed"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblB" Text="" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Slider Grid.Column="1" x:Name="SldB" Minimum="0" Maximum="1" TickFrequency="0.01"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ValB" Text="50" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblC" Text="" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Slider Grid.Column="1" x:Name="SldC" Minimum="0" Maximum="2" TickFrequency="0.01"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ValC" Text="50" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblG" Text="" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Slider Grid.Column="1" x:Name="SldG" Minimum="0.5" Maximum="6" TickFrequency="0.01"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ValG" Text="1.00" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblV" Text="" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Slider Grid.Column="1" x:Name="SldV" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ValV" Text="50" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblH" Text="" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <Slider Grid.Column="1" x:Name="SldH" Minimum="0" Maximum="359" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ValH" Text="0" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblS" Text="" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <Slider Grid.Column="1" x:Name="SldS" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ValS" Text="0" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="LblPanelOpacity" DockPanel.Dock="Right" Text="92%"
                               FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblPanelOpacityTitle" Text="Panel opacity" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <Slider x:Name="SldPanelOpacity" Minimum="0.55" Maximum="1" Value="0.92" TickFrequency="0.01"
                        ValueChanged="PanelOpacity_Changed" Margin="0,0,0,8"/>

                <CheckBox x:Name="ChkLockColor" Content="" Margin="0,0,0,8"
                          Foreground="{DynamicResource TextBrush}"/>

                <Button x:Name="BtnApply" Style="{StaticResource CompactAccentButton}"
                        MinHeight="32" Margin="0,0,0,6" Click="Apply_Click">
                    <TextBlock x:Name="TxtApply" TextTrimming="CharacterEllipsis"/>
                </Button>
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <Button x:Name="BtnAb" Content="A/B" Style="{StaticResource CompactGhostButton}"
                            MinHeight="32" Margin="0,0,3,0" Click="Ab_Click"/>
                    <Button x:Name="BtnEmergency" Content="Reset display" Style="{StaticResource DangerGhostButton}"
                            MinHeight="32" Margin="3,0,0,0" Click="Emergency_Click"/>
                </UniformGrid>
                <Expander x:Name="ExpMore" Header="More" IsExpanded="False">
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button x:Name="BtnSavePreset" Style="{StaticResource CompactGhostButton}"
                                Margin="0,0,4,0" Click="SaveAsPreset_Click"/>
                        <Button x:Name="BtnReset" Style="{StaticResource CompactGhostButton}"
                                Margin="4,0,0,0" Click="Reset_Click"/>
                    </UniformGrid>
                </Expander>
            </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
