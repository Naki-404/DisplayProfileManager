<Project>
  <!-- Single source of truth for version and branding (app + installer).
       build-release.ps1 reads <Version> from here. -->
  <PropertyGroup>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Keep InformationalVersion clean ("2.0.0", not "2.0.0+<git sha>"); the UI shows it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Nakidev</Company>
    <Authors>Nakidev</Authors>
    <Copyright>Copyright (c) Nakidev</Copyright>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
