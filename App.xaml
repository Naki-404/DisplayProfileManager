<Application x:Class="Visor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Visor"
             xmlns:controls="clr-namespace:Visor.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Visor brand (dark slate + cyan → violet). ThemeService.ApplyPalette overwrites these at runtime. -->
        <!-- Visor Noir tokens. ThemeService.ApplyPalette overwrites brushes at runtime. -->
        <SolidColorBrush x:Key="BgBrush" Color="#0A0C10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#12161C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1E2630"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EEF4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B9AAB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#67E8F9"/>
        <SolidColorBrush x:Key="AccentAltBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E05252"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#EF6B6B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="SuccessButtonTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#1F2835"/>
        <SolidColorBrush x:Key="GhostBgBrush" Color="#151A22"/>
        <SolidColorBrush x:Key="GhostBorderBrush" Color="#1E2630"/>
        <SolidColorBrush x:Key="GhostHoverBrush" Color="#1B2431"/>
        <SolidColorBrush x:Key="AccentButtonTextBrush" Color="#06121A"/>
        <SolidColorBrush x:Key="CheckCheckedBgBrush" Color="#0E2A33"/>
        <SolidColorBrush x:Key="ComboHighlightBrush" Color="#1A2330"/>
        <SolidColorBrush x:Key="ComboSelectedBrush" Color="#1C2C3A"/>
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#162230"/>
        <SolidColorBrush x:Key="TabHoverBrush" Color="#131A24"/>
        <SolidColorBrush x:Key="CaptionHoverBrush" Color="#1B2431"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#0D1218"/>
        <SolidColorBrush x:Key="PillBgBrush" Color="#10242E"/>
        <SolidColorBrush x:Key="ToastBgBrush" Color="#151A22"/>
        <SolidColorBrush x:Key="ToastBorderBrush" Color="#2A3A4F"/>
        <SolidColorBrush x:Key="ScrimBrush" Color="#CC0A0C10"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#668B9AAB"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#CC8B9AAB"/>
        <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <!-- Dashboard cards (Stage 1 shell). ThemeService derives these from the palette at runtime. -->
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1E2630"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#2B3A4C"/>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Nav / chrome icons (24×24 vector paths, Material Design Icons, Apache-2.0) -->
        <Geometry x:Key="IconHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</Geometry>
        <Geometry x:Key="IconMyPc">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z</Geometry>
        <Geometry x:Key="IconGames">M7.97,16L5,19C4.67,19.3 4.23,19.5 3.75,19.5A1.75,1.75 0 0,1 2,17.75V17.5L3,10.12C3.21,7.81 5.14,6 7.5,6H16.5C18.86,6 20.79,7.81 21,10.12L22,17.5V17.75A1.75,1.75 0 0,1 20.25,19.5C19.77,19.5 19.33,19.3 19,19L16.03,16H7.97M7,8V10H5V11H7V13H8V11H10V10H8V8H7M16.5,8A0.75,0.75 0 0,0 15.75,8.75A0.75,0.75 0 0,0 16.5,9.5A0.75,0.75 0 0,0 17.25,8.75A0.75,0.75 0 0,0 16.5,8M14.75,9.75A0.75,0.75 0 0,0 14,10.5A0.75,0.75 0 0,0 14.75,11.25A0.75,0.75 0 0,0 15.5,10.5A0.75,0.75 0 0,0 14.75,9.75M18.25,9.75A0.75,0.75 0 0,0 17.5,10.5A0.75,0.75 0 0,0 18.25,11.25A0.75,0.75 0 0,0 19,10.5A0.75,0.75 0 0,0 18.25,9.75M16.5,11.5A0.75,0.75 0 0,0 15.75,12.25A0.75,0.75 0 0,0 16.5,13A0.75,0.75 0 0,0 17.25,12.25A0.75,0.75 0 0,0 16.5,11.5Z</Geometry>
        <Geometry x:Key="IconOptimize">M7,2V13H10V22L17,10H13L17,2H7Z</Geometry>
        <Geometry x:Key="IconNetwork">M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.8C8.1,12.67 9.97,12 12,12C14.03,12 15.9,12.67 17.4,13.8L19.2,11.4C17.19,9.89 14.7,9 12,9Z</Geometry>
        <Geometry x:Key="IconSettings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</Geometry>
        <Geometry x:Key="IconHelp">M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z</Geometry>
        <Geometry x:Key="IconCollapse">M18.41,7.41L17,6L11,12L17,18L18.41,16.59L13.83,12L18.41,7.41M12.41,7.41L11,6L5,12L11,18L12.41,16.59L7.83,12L12.41,7.41Z</Geometry>
        <Geometry x:Key="IconExpand">M5.59,7.41L7,6L13,12L7,18L5.59,16.59L10.17,12L5.59,7.41M11.59,7.41L13,6L19,12L13,18L11.59,16.59L16.17,12L11.59,7.41Z</Geometry>
        <Geometry x:Key="IconThemes">M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.5C12.88,18.23 12.73,17.88 12.73,17.5A1.5,1.5 0 0,1 14.23,16H16A5,5 0 0,0 21,11C21,6.58 16.97,3 12,3Z</Geometry>
        <Geometry x:Key="IconChevronRight">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</Geometry>
        <!-- "More" (⋯) — vector so the dots sit on the optical center instead of the text baseline. -->
        <Geometry x:Key="IconMore">M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z</Geometry>
<local:NullToVisibilityConverter x:Key="NullToVis"/>
        <local:InvertNullToVisibilityConverter x:Key="InvNullToVis"/>
        <local:TileForegroundConverter x:Key="TileFg"/>
        <local:TileForegroundConverter x:Key="TileFgMuted" Muted="True"/>
        <local:PresetSummaryConverter x:Key="PresetSummary"/>
        <local:CompanionLabelConverter x:Key="CompanionLabel"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0A0C10"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#12161C"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8EEF4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8EEF4"/>

        <!-- Keyboard focus rings — radius matches control chrome (buttons 10, fields 6) -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="10" RadiusY="10" SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FocusRingField">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============ Popup surfaces (ContextMenu, submenu, ComboBox dropdown) ============
             One look for every dropdown: radius 10, 1-DIP card border, 4-DIP inner padding so highlighted rows
             stay inside the rounded corners. The shadow is a separate layer BEHIND the chrome (an Effect on the
             chrome itself would rasterize the menu text and blur it at 125/150 %). Hosts reserve a 6,2,6,8
             margin around both layers for the blur. -->
        <Style x:Key="PopupChrome" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style x:Key="PopupShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.32" Color="#000000"
                                      RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared card surface (Phase 1 design system) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Color slider row (ColorSliderRow control): name + value text -->
        <Style x:Key="SliderName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Stage 1 shell: dashboard card, nav rail item, status dot, switch ============ -->

        <!-- Dashboard card: radius 14, 1-px themed border, inner padding 14 (the value every page already used
             explicitly; Optimize relied on the old default 18 and was the only page with fatter cards).
             Hover brightens the border. -->
        <Style x:Key="CardSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Card typography -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- CardLink (BasedOn LinkButton) is declared right after LinkButton: StaticResource cannot look forward. -->

        <!-- Page typography (shared by every shell page) -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Game tile used by the Games list -->
        <DataTemplate x:Key="GameTileTemplate">
            <Border CornerRadius="10" Padding="8,7" Background="{Binding TileBrush}" MinHeight="48"
                    ToolTip="{Binding ProcessName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="#33000000" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource InvNullToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{Binding TileBrush, Converter={StaticResource TileFg}}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                   Foreground="{Binding TileBrush, Converter={StaticResource TileFgMuted}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Sidebar nav item: icon + label, left accent bar when selected, icons-only when IsCompact. -->
        <Style TargetType="{x:Type controls:NavRailItem}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:NavRailItem}">
                        <!-- Wash / accent bar live outside the padded row, so they always fill the item exactly
                             (expanded and compact) instead of relying on negative margins that mirror Padding. -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="HoverWash" Background="{DynamicResource TabHoverBrush}" CornerRadius="9"
                                        Opacity="0" IsHitTestVisible="False"/>
                                <Border x:Name="AccentBar" Width="3" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="0,2,2,0" Background="{DynamicResource AccentGradientBrush}" Opacity="0"/>
                                <StackPanel x:Name="Row" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}">
                                    <Path x:Name="Ico" Width="18" Height="18" Stretch="Uniform"
                                          Data="{TemplateBinding Icon}" Fill="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Lbl" Text="{TemplateBinding Label}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <!-- The hover wash is darker than the selected fill: never draw it over the selection. -->
                                <Setter TargetName="HoverWash" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ico" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsCompact" Value="True">
                                <Setter TargetName="Lbl" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="Row" Property="Margin" Value="0,9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status dot: Ok / Warn / Bad / Unknown → Success / Warning / Danger / Muted, with a soft halo -->
        <Style TargetType="{x:Type controls:StatusDot}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:StatusDot}">
                        <Grid>
                            <Ellipse x:Name="Halo" Fill="{TemplateBinding Foreground}" Opacity="0.22" Margin="-3"/>
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Status" Value="Ok">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </Trigger>
                            <Trigger Property="Status" Value="Warn">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </Trigger>
                            <Trigger Property="Status" Value="Bad">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="Status" Value="Unknown">
                                <Setter TargetName="Halo" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch toggle (Tooltip mode, Home → Settings card). Content = label on the left. Instant triggers → reduced-motion safe. -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <DockPanel Background="Transparent" LastChildFill="True">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="36" Height="20" CornerRadius="10"
                                    Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0"
                                         Fill="{DynamicResource MutedBrush}"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentButtonTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon-only chrome button (sidebar collapse, top-bar gear) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Headerless section host — selection driven by the sidebar -->
        <Style x:Key="ShellTabControlStyle" TargetType="controls:ShellTabControl">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <!-- Continue (not Local): Tab must be able to leave page content back to the sidebar. -->
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="controls:ShellTabItem">
                        <!-- Keep selected content; only strip focus/header chrome (panel is collapsed). -->
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="controls:ShellTabItem">
                                    <Border x:Name="Bd" Background="Transparent" Height="0" Width="0"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:ShellTabControl">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- Keep items host off-layout so TabItems stay in the logical tree -->
                            <TabPanel IsItemsHost="True" Height="0" Width="0" Opacity="0"
                                      IsHitTestVisible="False" Focusable="False"
                                      KeyboardNavigation.TabNavigation="None"
                                      Visibility="Collapsed"/>
                            <ContentPresenter ContentSource="SelectedContent"
                                              KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Text field. Tag = placeholder text. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <!-- Same outer height as ComboBox (MinHeight 34) so fields line up in forms and rows. -->
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingField}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- No Border padding: TextBoxBase already applies Padding inside PART_ContentHost. -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Visibility="Collapsed"
                                           Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Multi-line text (log view) starts at the top instead of floating in the middle. -->
                <Trigger Property="AcceptsReturn" Value="True">
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBox — supports IsEditable via PART_EditableTextBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingField}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource MutedBrush}"
                                                          StrokeThickness="1.5" Fill="Transparent"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="10,5,32,5"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <!-- MinHeight 0: the implicit TextBox MinHeight (34) + this margin would make editable
                                 combos 2 DIP taller than read-only ones. -->
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" MinHeight="0"
                                     Margin="8,1,30,1" Padding="2,0" VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     Focusable="True"
                                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                          VerticalAlignment="Center"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <!-- Dropdown: same chrome as ContextMenu (PopupChrome). The 6-DIP side margin hosts the
                                 shadow; HorizontalOffset -6 keeps the list's left edge flush with the field, and
                                 MinWidth = field width keeps the list at least as wide as the toggle. -->
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   HorizontalOffset="-6" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   UseLayoutRounding="True">
                                <Grid Margin="6,2,6,8" MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Style="{StaticResource PopupShadow}"/>
                                    <Border Style="{StaticResource PopupChrome}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown row: 32 DIP like menu items, rounded highlight inset by the popup padding. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboSelectedBrush}"/>
                            </Trigger>
                            <!-- Highlight after Selected: the row under the pointer / keyboard cursor always shows. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboHighlightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Menus (⋯ buttons, any ContextMenu) ============
             Replaces the Aero2 look (light gutter, system colors, uneven heights): themed PopupChrome, 32-DIP rows,
             12-DIP text inset, icon/check column that collapses to 0 when no row uses it (SharedSizeGroup),
             right-aligned InputGestureText, submenu chevron, muted disabled rows. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- 6,2,6,8: room for the shadow layer. Callers that place the menu against a control
                             (GamesPage ⋯ buttons) compensate with MenuPlacement.ShadowInset. -->
                        <Grid Margin="6,2,6,8">
                            <Border x:Name="Shadow" Style="{StaticResource PopupShadow}"/>
                            <Border Style="{StaticResource PopupChrome}">
                                <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasDropShadow" Value="False">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu separator (MenuBase applies MenuItem.SeparatorStyleKey to <Separator/> items automatically). -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="12,4" Background="{DynamicResource BorderBrush}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- The highlighted row is the keyboard cursor; a dashed focus rectangle on top would be noise. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuArrow"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon / check column: collapsed (0 width) unless a row has an icon or is checkable. -->
                                <Grid x:Name="IconHost" Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="IconPresenter" ContentSource="Icon"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="CheckMark" Visibility="Collapsed" Width="10" Height="10" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M0,5 L3.5,8.5 L10,1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Grid>
                                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Margin="12,0,12,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed" Width="5" Height="9" Stretch="Uniform"
                                      Margin="0,0,12,0" VerticalAlignment="Center" Data="M0,0 L4,4 L0,8"
                                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-7"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" UseLayoutRounding="True">
                                <Grid Margin="6,2,6,8" Grid.IsSharedSizeScope="True" MinWidth="180">
                                    <Border Style="{StaticResource PopupShadow}"/>
                                    <Border Style="{StaticResource PopupChrome}">
                                        <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                            KeyboardNavigation.TabNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-6"/>
                                <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="0"/>
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboHighlightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboHighlightBrush}"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter TargetName="IconHost" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Arrow" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="16" Height="16"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="{DynamicResource FieldBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="Check" Visibility="Collapsed"
                                          Data="M0,5 L3.5,8.5 L10,1"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Viewbox>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckCheckedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action. Radius 10; hover wash + pressed opacity (instant, reduced-motion safe).
             Height parity: accent templates draw no border, ghost templates draw 1 DIP, so accent padding is 1 DIP
             taller per side (18,10 vs 18,9 · compact 14,8 vs 14,7) — an accent and a ghost button in the same
             row are exactly the same height (≈37 / 32 DIP) instead of differing by 2 DIP. -->
        <Style TargetType="Button" x:Key="AccentButton">
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource AccentBrush}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid>
                                <Border x:Name="HoverWash" Background="#FFFFFF" Opacity="0" CornerRadius="10"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackBrush}"/>
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive primary action (confirm Delete / Reset) -->
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource DangerBrush}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Positive primary (applied / resume) -->
        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Foreground" Value="{DynamicResource SuccessButtonTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SuccessBrush}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid>
                                <Border x:Name="HoverWash" Background="#FFFFFF" Opacity="0" CornerRadius="10"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="GhostButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource GhostBgBrush}"
                                BorderBrush="{DynamicResource GhostBorderBrush}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True"
                                ClipToBounds="False">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive ghost (Delete / Remove / Reset) — red text at rest, red border on hover and keyboard focus -->
        <Style TargetType="Button" x:Key="DangerGhostButton" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource GhostBgBrush}"
                                BorderBrush="{DynamicResource GhostBorderBrush}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact ghost for tight toolbars (preset Export/Import, Clear, etc.) -->
        <Style TargetType="Button" x:Key="CompactGhostButton" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="Button" x:Key="CompactAccentButton" BasedOn="{StaticResource AccentButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Pill chip for Play presets -->
        <Style TargetType="Button" x:Key="ChipButton" BasedOn="{StaticResource CompactGhostButton}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button" x:Key="ChipButtonSelected" BasedOn="{StaticResource CompactAccentButton}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Inline text link (e.g. "Edit in Presets") -->
        <Style TargetType="Button" x:Key="LinkButton">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card header link ("Open", "Details") -->
        <Style x:Key="CardLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Two-state segmented toggle used as a sub-tab (More → Defaults / Log) -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="0,0,6,0"
                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                MaxWidth="{TemplateBinding MaxWidth}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar caption buttons — minimal chrome -->
        <Style TargetType="Button" x:Key="CaptionButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CaptionCloseButton" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                BorderThickness="1" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Game tile row: no padding, selection drawn ON the tile so every tile keeps the same width -->
        <Style x:Key="TileListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True">
                            <ContentPresenter/>
                            <Border x:Name="Sel" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Sel" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Game tiles announce the game name (the template is a colored card, not text). -->
        <Style x:Key="GameTileItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" Background="{DynamicResource TrackBrush}" CornerRadius="2" Margin="6,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="6,0,0,0"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Fill="{DynamicResource AccentBrush}"
                                                         Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="{DynamicResource BgBrush}"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1" Background="{DynamicResource BgBrush}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,6,0">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    CornerRadius="10,10,0,0" SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  Focusable="False"/>
                            </Border>
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                    Margin="10,0" Background="{DynamicResource BrandGradientBrush}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Scrollbars ============
             Overlay indicator (Windows 11 style): the bar is drawn ON TOP of the content (no reserved column, no
             layout shift), is Collapsed whenever the content fits (Auto → ComputedVisibility), and is invisible at
             rest. controls:ScrollIndicator fades it in while the user scrolls / moves the pointer over the area and
             fades it out ~1.2 s later unless the pointer is on the bar or the thumb is being dragged. The thumb is a
             4-DIP line that widens to 7 DIP when the pointer reaches the 10-DIP hit strip. -->
        <ControlTemplate x:Key="VScrollTemplate" TargetType="ScrollBar">
            <Border Background="Transparent" Width="{TemplateBinding Width}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent">
                                        <Border x:Name="T" Width="4" HorizontalAlignment="Right" Margin="0,2,2,2"
                                                CornerRadius="2" Background="{DynamicResource ScrollThumbBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                            <Setter TargetName="T" Property="Width" Value="7"/>
                                            <Setter TargetName="T" Property="CornerRadius" Value="3.5"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="T" Property="Width" Value="7"/>
                                            <Setter TargetName="T" Property="CornerRadius" Value="3.5"/>
                                            <Setter TargetName="T" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="HScrollTemplate" TargetType="ScrollBar">
            <Border Background="Transparent" Height="{TemplateBinding Height}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False" Opacity="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent">
                                        <Border x:Name="T" Height="4" VerticalAlignment="Bottom" Margin="2,0,2,2"
                                                CornerRadius="2" Background="{DynamicResource ScrollThumbBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                            <Setter TargetName="T" Property="Height" Value="7"/>
                                            <Setter TargetName="T" Property="CornerRadius" Value="3.5"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="T" Property="Height" Value="7"/>
                                            <Setter TargetName="T" Property="CornerRadius" Value="3.5"/>
                                            <Setter TargetName="T" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False" Opacity="0"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template" Value="{StaticResource VScrollTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource HScrollTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="controls:ScrollIndicator.AutoHide" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <!-- Overlay bars: on top of the content, no layout cost. Opacity is driven by ScrollIndicator. -->
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical" HorizontalAlignment="Right"
                                       Opacity="0" Margin="0,2,0,2"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Orientation="Horizontal" VerticalAlignment="Bottom"
                                       Opacity="0" Margin="2,0,10,0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page-level scroller (every shell page). Extends 12 DIP into the main column's right gutter so the overlay
             bar sits in the gutter instead of on top of the cards' right border, and 4 DIP to the left so focus rings
             of left-aligned controls are not clipped by the viewport. Page roots add the matching 4,_,12,_ margin,
             so content edges stay aligned with the top bar. -->
        <Style x:Key="PageScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="Margin" Value="-4,0,-12,0"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
        </Style>

        <!-- Two-way color backend switch: Unchecked = GPU driver (left, Content), Checked = Low Level (right, Tag) -->
        <Style x:Key="BackendSlideToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{DynamicResource TrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="22" Padding="6,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Sliding thumb -->
                                <Border x:Name="Thumb" Grid.Column="0" CornerRadius="16"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="2"/>
                                <TextBlock x:Name="LblLeft" Grid.Column="0"
                                           Text="{TemplateBinding Content}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="12"
                                           Padding="6,2" TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource AccentButtonTextBrush}"/>
                                <TextBlock x:Name="LblRight" Grid.Column="1"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='Low Level'}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="12"
                                           Padding="6,2" TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="LblLeft" Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="LblLeft" Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
                                <Setter TargetName="LblRight" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="LblRight" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="LblLeft" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="LblLeft" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter TargetName="LblRight" Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="LblRight" Property="Foreground" Value="{DynamicResource AccentButtonTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <!-- Themed Expander (Advanced / More) -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource GhostBgBrush}"
                                          BorderBrush="{DynamicResource GhostBorderBrush}"
                                          BorderThickness="1"
                                          Padding="12,8"
                                          Cursor="Hand"
                                          FocusVisualStyle="{StaticResource FocusRing}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                                            <DockPanel>
                                                <Path x:Name="Arrow" DockPanel.Dock="Right"
                                                      Width="10" Height="6" Stretch="Uniform" Margin="10,0,0,0"
                                                      Fill="{DynamicResource MutedBrush}"
                                                      VerticalAlignment="Center"
                                                      Data="M0,0 L5,5 L10,0 Z"/>
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M0,5 L5,0 L10,5 Z"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource TextBrush}"/>
                            </ToggleButton>
                            <Border x:Name="ExpandSite" Visibility="Collapsed" Margin="0,10,0,0"
                                    Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
